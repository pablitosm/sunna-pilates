---
import Horario from '../Horario.astro';
import MapaEstudio from '../MapaEstudio.astro';
import { mapsUrl, type Ajustes, type Home } from '../../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { ajustes, home } = Astro.props;
const { estudio } = home;
const d = ajustes.direccion;

---

<section id="estudio" class="estudio seccion" aria-labelledby="estudio-titulo">
  <div class="envoltura">
    <div class="cabeza-seccion">
      <h2 id="estudio-titulo" class="t-h2">{estudio.titulo}</h2>
    </div>

    <!-- El mapa entero lleva a Google Maps -->
    <a class="mapa" href={mapsUrl(ajustes)} target="_blank" rel="noopener" aria-label={`${estudio.mapa.abrir}: ${d.calle}, ${d.codigoPostal} ${d.ciudad}`}>
      <!-- Dibujado con datos reales de OpenStreetMap (scripts/mapa-estudio.mjs) -->
      <MapaEstudio />
      <span class="mapa__credito">© OpenStreetMap</span>
    </a>

    <!-- Bajo el mapa, el dónde y el cuándo: dirección a la izquierda, horario a la derecha -->
    <div class="lugar">
      <div>
        <p class="etiqueta lugar__etiqueta">{estudio.mapa.direccion}</p>
        <address class="lugar__direccion">
          {d.calle}
          <br />
          {d.codigoPostal} {d.ciudad}
        </address>
        {
          d.comoLlegar && (
            <>
              <p class="etiqueta lugar__etiqueta lugar__etiqueta--llegar">{estudio.mapa.comoLlegar}</p>
              <p class="lugar__llegar">{d.comoLlegar}</p>
            </>
          )
        }
        <a class="enlace-flecha lugar__enlace" href={mapsUrl(ajustes)} target="_blank" rel="noopener">
          {estudio.mapa.abrir} <span aria-hidden="true">→</span>
        </a>
      </div>
      <Horario ajustes={ajustes} home={home} derecha />
    </div>
  </div>
</section>

<style>
  /* El estudio va sobre tostado: la sección con tinte entre Cómo funciona y las preguntas (crema) */
  .estudio {
    background: var(--tostado);
  }

  /* Mapa dibujado, siempre visible; todo él es un enlace */
  .mapa {
    display: block;
    position: relative;
    height: clamp(20rem, 14rem + 18vw, 32rem);
    border-radius: var(--r-l);
    overflow: hidden;
    background: var(--n100);
  }

  /* Atribución obligatoria de los datos (licencia ODbL) */
  .mapa__credito {
    position: absolute;
    right: 0.875rem;
    bottom: 0.625rem;
    font-size: 0.6875rem;
    color: var(--tinta-60);
  }

  .mapa:focus-visible {
    outline: 3px solid var(--n500);
    outline-offset: 4px;
  }

  /* Dirección y horario bajo el mapa, sin panel: la dirección pegada al borde
     izquierdo del mapa y el horario al derecho, como en espejo */
  .lugar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2.25rem clamp(2rem, 1rem + 4vw, 6rem);
    align-items: start;
    margin-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
  }

  .lugar__etiqueta {
    margin-bottom: 0.625rem;
  }

  .lugar__etiqueta--llegar {
    margin-top: 1.5rem;
  }

  .lugar__direccion {
    font-size: var(--t-h3);
    line-height: 1.3;
    letter-spacing: -0.015em;
    font-style: normal;
  }

  .lugar__llegar {
    max-width: 40ch;
    color: var(--tinta-60);
  }

  .lugar__enlace {
    margin-top: 1.25rem;
  }

  @media (max-width: 56.25rem) {
    .lugar {
      grid-template-columns: 1fr;
    }
  }
</style>
