---
/*
 * Recovery y los tres espacios: el reformer, la sauna y la sala de luz roja.
 * Cada espacio tiene además su propia página (pagina + tipos) con este mismo apartado.
 * Cada apartado es un arco (foto real o ilustración de línea) junto a su
 * explicación y lo que incluye cada membresía. La luz roja lleva su propio
 * rojo (--rojo-*); el resto vive en la escala naranja.
 */
import ArcoEspacio from '../ArcoEspacio.astro';
import type { Home } from '../../lib/content';

interface Props {
  home: Home;
  /** Solo estos espacios (la página de cada espacio muestra uno). */
  tipos?: Home['recovery']['apartados'][number]['tipo'][];
  /** Como página propia: sin cabecera de sección y con el título como h1. */
  pagina?: boolean;
}
const { home, tipos, pagina = false } = Astro.props;
const { recovery } = home;
const apartados = tipos ? recovery.apartados.filter((a) => tipos.includes(a.tipo)) : recovery.apartados;
const Titulo = pagina ? 'h1' : 'h3';
---

<section
  id={pagina ? undefined : 'recovery'}
  class:list={['recovery seccion', { 'recovery--pagina': pagina }]}
  aria-labelledby={pagina ? undefined : 'recovery-titulo'}
>
  <div class="envoltura">
    {!pagina && (
    <header class="recovery__cabeza">
      <div>
        <p class="etiqueta recovery__etiqueta">{recovery.etiqueta}</p>
        <h2 id="recovery-titulo" class="t-h2">{recovery.titulo}</h2>
      </div>
      <div class="recovery__lineas">
        {recovery.lineas.map((l, i) => <p class:list={['recovery__linea', { 'recovery__linea--suave': i > 0 }]}>{l}</p>)}
      </div>
    </header>
    )}

    <ul role="list" class="apartados">
      {
        apartados.map((a) => (
          <li class:list={['apartado', `apartado--${a.tipo}`]}>
            <div class="apartado__visual">
              <ArcoEspacio tipo={a.tipo} foto={a.foto} class="apartado__arco" />
            </div>

            <div class="apartado__texto">
              <Titulo class="apartado__titulo">{a.titulo}</Titulo>
              <p class="apartado__intro">{a.texto}</p>

              <ul role="list" class="apartado__puntos">
                {a.puntos.map((p) => <li>{p}</li>)}
              </ul>

              <div class="apartado__plan">
                <p class="etiqueta apartado__plan-titulo">{recovery.membresiaTitulo}</p>
                <dl>
                  {a.membresia.map((m) => (
                    <div class:list={['plan', { 'plan--fuera': /^(no|not|nicht|non)\b/i.test(m.cantidad) }]}>
                      <dt>{m.plan}</dt>
                      <dd>{m.cantidad}</dd>
                    </div>
                  ))}
                </dl>
              </div>

              {a.pendiente && <p class="pendiente apartado__pendiente">{a.pendiente}</p>}
            </div>
          </li>
        ))
      }
    </ul>

    {recovery.aviso && <p class="recovery__aviso">{recovery.aviso}</p>}
  </div>
</section>

<style>
  .recovery {
    background: var(--n50);
    overflow-x: clip;
  }

  /* Cabecera: título a la izquierda, las dos líneas del brief a la derecha */
  .recovery__cabeza {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
    gap: 1.5rem clamp(2.5rem, 1rem + 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(3.5rem, 2rem + 5vw, 6.5rem);
  }

  .recovery__etiqueta {
    margin-bottom: 1.625rem;
  }

  .recovery__linea {
    margin-bottom: 0.5rem;
    font-size: 1.1875rem;
    line-height: 1.6;
  }

  .recovery__linea--suave {
    font-size: 1.0625rem;
    color: var(--tinta-60);
  }

  /* Página propia de un espacio: el apartado hace de portada */
  .recovery--pagina {
    padding-top: var(--pagina-arriba);
  }

  .recovery--pagina .apartado__titulo {
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4rem);
    line-height: 1.02;
  }

  /* ───────── Apartados ───────── */
  .apartados {
    display: grid;
    gap: clamp(4.5rem, 3rem + 5vw, 8rem);
  }

  .apartado {
    --acento: var(--n700);
    --texto-acento: var(--n900);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 2rem clamp(2.5rem, 1rem + 5vw, 6rem);
    align-items: center;
  }

  /* Alterna el lado del arco */
  .apartado:nth-child(even) .apartado__visual {
    order: 2;
  }

  .apartado--luz-roja {
    --acento: var(--rojo-500);
    --texto-acento: var(--rojo-900);
  }

  /* Halo rojo detrás de la sala de luz roja: luz, no bloque */
  .apartado--luz-roja::before {
    content: '';
    position: absolute;
    inset: -18% -10% -18% -30%;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(45% 55% at 30% 50%, rgb(236 74 50 / 0.2), rgb(236 74 50 / 0) 70%);
  }

  .apartado--luz-roja:nth-child(even)::before {
    inset: -18% -30% -18% -10%;
    background: radial-gradient(45% 55% at 70% 50%, rgb(236 74 50 / 0.2), rgb(236 74 50 / 0) 70%);
  }

  .apartado__visual,
  .apartado__texto {
    position: relative;
    z-index: 1;
  }

  /* El arco: 180 px arriba, 28 px abajo */
  .apartado :global(.apartado__arco) {
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
  }

  /* ───────── Texto ───────── */
  .apartado__titulo {
    margin-bottom: 1.25rem;
    font-size: clamp(2rem, 1.6rem + 1.8vw, 2.75rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
  }

  .apartado__intro {
    max-width: 42ch;
    font-size: var(--t-lead);
    line-height: 1.5;
  }

  .apartado__puntos {
    display: grid;
    gap: 0.625rem;
    margin-top: 1.75rem;
  }

  .apartado__puntos li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--tinta-60);
  }

  .apartado__puntos li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.875rem;
    height: 2px;
    border-radius: 2px;
    background: var(--acento);
  }

  /* Qué incluye cada membresía */
  .apartado__plan {
    margin-top: 2.25rem;
  }

  .apartado__plan-titulo {
    margin-bottom: 0.875rem;
    color: var(--texto-acento);
  }

  .apartado__plan dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--linea-fuerte);
  }

  .plan {
    padding: 0.875rem 0.75rem 0 0;
  }

  .plan + .plan {
    padding-left: 0.875rem;
    border-left: 1px solid var(--linea);
  }

  .plan dt {
    font-size: 0.8125rem;
    color: var(--tinta-60);
  }

  .plan dd {
    margin-top: 0.25rem;
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .plan--fuera dd {
    color: var(--tinta-60);
  }

  .apartado__pendiente {
    margin-top: 1.5rem;
  }

  .recovery__aviso {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    padding: 1.25rem 1.5rem;
    border-radius: var(--r-s);
    border: 1px solid var(--linea-fuerte);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--tinta-60);
  }

  @media (max-width: 56.25rem) {
    .recovery__cabeza,
    .apartado {
      grid-template-columns: 1fr;
    }

    .apartado:nth-child(even) .apartado__visual {
      order: 0;
    }

    .apartado--luz-roja::before,
    .apartado--luz-roja:nth-child(even)::before {
      inset: -10% -20% 40% -20%;
      background: radial-gradient(60% 50% at 50% 50%, rgb(236 74 50 / 0.18), rgb(236 74 50 / 0) 70%);
    }

    .apartado :global(.apartado__arco) {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 36rem) {
    .apartado__plan dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .plan:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .plan:nth-child(n + 3) {
      margin-top: 0.875rem;
      border-top: 1px solid var(--linea);
    }
  }
</style>
