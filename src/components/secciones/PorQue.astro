---
/*
 * Por qué SUNNA frente a otros estudios (horario amplio y todo autónomo). Va justo
 * después de la portada para que se entienda el modelo sin bajar mucho.
 */
import { acentuar } from '../../lib/acento';
import DibujoRazon from '../DibujoRazon.astro';
import { idiomaDe, type Ajustes, type Home } from '../../lib/content';
import { conHorario, tramosHorario } from '../../lib/horario';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { ajustes, home } = Astro.props;
const pq = home.porQue;
// Con el horario ampliado, las razones que lo tienen usan su título y texto alternativos.
// {horario} en los textos se cambia por el horario vigente, escrito en cada idioma.
const lang = idiomaDe(Astro.currentLocale);
const razones = (pq?.razones ?? [])
  .map((r) => (ajustes.horario === 'ampliado' && r.ampliado) || r)
  .map((r) => ({ titulo: conHorario(r.titulo, ajustes, lang), texto: conHorario(r.texto, ajustes, lang) }));
// La apertura y el cierre del día, para el dibujo del horario
const tramos = tramosHorario(ajustes);
const dia: [string, string] = [tramos[0][0], tramos[tramos.length - 1][1]];
const dibujos = ['horario', 'autonomo', 'ritmo'] as const;
---

{
  pq && (
    <section id="por-que" class="porque seccion" aria-labelledby="porque-titulo">
      <div class="envoltura">
        <h2 id="porque-titulo" class="t-h2" set:html={acentuar(pq.titulo)} />

        <ul role="list" class="razones">
          {razones.map((r, i) => (
            <li class="razon">
              <div class="razon__lamina grano">
                <DibujoRazon tipo={dibujos[i % dibujos.length]} horas={dia} />
              </div>
              <h3 class="razon__titulo">{r.titulo}</h3>
              <p class="razon__texto">{r.texto}</p>
            </li>
          ))}
        </ul>
      </div>

    </section>
  )
}

<style>
  /* Tres razones en columnas, colgadas de una línea fina */
  .razones {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 clamp(1.5rem, 0.5rem + 2.5vw, 3rem);
    margin-top: var(--titulo-contenido);
    border-top: 1px solid var(--linea-fuerte);
  }

  .razon {
    padding-top: clamp(1.75rem, 1.25rem + 1vw, 2.25rem);
  }

  /* Cada razón con su recorte de papel, a sangre y con el grano del papel encima */
  .razon__lamina {
    position: relative;
    max-width: 100%;
    aspect-ratio: 24 / 17;
    border-radius: var(--r);
    overflow: hidden;
  }


  .razon__titulo {
    margin-top: 1.5rem;
    font-size: 1.375rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .razon__texto {
    max-width: 36ch;
    margin-top: 0.625rem;
    color: var(--tinta-60);
    line-height: 1.6;
  }

  @media (max-width: 56.25rem) {
    .razones {
      grid-template-columns: 1fr;
      border-top: 0;
    }

    .razon {
      display: grid;
      grid-template-columns: clamp(7.5rem, 5rem + 12vw, 11rem) minmax(0, 1fr);
      gap: 0.375rem 1.25rem;
      align-items: center;
      padding: 1.5rem 0;
      border-top: 1px solid var(--linea);
    }

    .razon:first-child {
      border-top-color: var(--linea-fuerte);
    }

    .razon__lamina {
      grid-row: span 2;
      align-self: start;
    }

    .razon__titulo {
      margin-top: 0;
      align-self: end;
    }

    .razon__texto {
      margin-top: 0;
    }
  }

  /* En el móvil, la lámina a lo ancho encima del texto para que el dibujo se vea */
  @media (max-width: 40rem) {
    .razon {
      grid-template-columns: minmax(0, 1fr);
      padding: 1.75rem 0;
    }

    .razon__lamina {
      grid-row: auto;
      margin-bottom: 0.875rem;
    }
  }
</style>
