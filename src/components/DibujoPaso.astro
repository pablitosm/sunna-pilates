---
/*
 * Dibujo de cada paso de «Cómo funciona», en recortes de papel como el resto de la web:
 * formas planas sin contorno, colores de la paleta, dentro de un medallón redondo.
 * arco: amanece (la primera sesión) · pantalla: el móvil con la hora reservada ·
 * punto: el iPad del reformer con el play · reserva: la hoja del calendario con la hora
 * marcada. Otro icono: el glifo de trazo de siempre.
 */
import Glifo from './Glifo.astro';

interface Props {
  icono: string;
  class?: string;
}
const { icono, class: className } = Astro.props;
const id = `dibujo-paso-${icono}`;
const conDibujo = ['arco', 'pantalla', 'punto', 'reserva'].includes(icono);
---

{
  conDibujo ? (
    <svg class:list={['dibujo', className]} viewBox="0 0 120 120" aria-hidden="true" focusable="false">
      <clipPath id={id}>
        <circle cx="60" cy="60" r="60" />
      </clipPath>
      <g clip-path={`url(#${id})`}>
        {icono === 'arco' && (
          <>
            <rect class="d-cielo" width="120" height="120" />
            <circle class="d-halo" cx="60" cy="80" r="44" />
            <circle class="d-sol" cx="60" cy="80" r="28" />
            <rect class="d-suelo" y="80" width="120" height="40" />
            <rect class="d-suelo-claro" y="92" width="120" height="6" />
          </>
        )}
        {icono === 'pantalla' && (
          <>
            <rect class="d-fondo" width="120" height="120" />
            <g transform="rotate(-8 60 64)">
              <rect class="d-cacao" x="37" y="20" width="46" height="88" rx="9" />
              <rect class="d-pantalla" x="42" y="28" width="36" height="72" rx="4" />
              <rect class="d-hueco" x="47" y="36" width="26" height="9" rx="2" />
              <rect class="d-reserva" x="47" y="50" width="26" height="14" rx="2" />
              <rect class="d-hueco" x="47" y="69" width="26" height="9" rx="2" />
              <rect class="d-hueco" x="47" y="83" width="26" height="9" rx="2" />
            </g>
          </>
        )}
        {icono === 'punto' && (
          <>
            <rect class="d-cielo" width="120" height="120" />
            <rect class="d-cacao" x="16" y="30" width="88" height="60" rx="8" />
            <rect class="d-pantalla-calida" x="22" y="36" width="76" height="48" rx="3" />
            <circle class="d-sol" cx="60" cy="60" r="15" />
            <path class="d-claro" d="M55.5 52.5v15l12-7.5z" />
            <rect class="d-cacao" x="54" y="90" width="12" height="16" />
            <rect class="d-suelo" x="30" y="104" width="60" height="16" rx="3" />
          </>
        )}
        {icono === 'reserva' && (
          <>
            <rect class="d-fondo" width="120" height="120" />
            <g transform="rotate(5 60 64)">
              <rect class="d-pantalla" x="24" y="28" width="72" height="72" rx="6" />
              <path class="d-cacao" d="M24 34a6 6 0 0 1 6-6h60a6 6 0 0 1 6 6v10H24z" />
              <rect class="d-cacao" x="38" y="20" width="6" height="16" rx="3" />
              <rect class="d-cacao" x="76" y="20" width="6" height="16" rx="3" />
              {[0, 1, 2].flatMap((f) =>
                [0, 1, 2, 3].map((c) => (
                  <rect
                    class={f === 1 && c === 2 ? 'd-reserva' : 'd-hueco'}
                    x={33 + c * 14}
                    y={52 + f * 14}
                    width="10"
                    height="10"
                    rx="2"
                  />
                )),
              )}
            </g>
          </>
        )}
      </g>
    </svg>
  ) : (
    <Glifo forma={icono as Parameters<typeof Glifo>[0]['forma']} tamano={96} />
  )
}

<style>
  .dibujo {
    display: block;
    width: 100%;
    height: auto;
  }

  .d-cielo {
    fill: var(--sol-100);
  }

  .d-fondo {
    fill: var(--sol-200);
  }

  .d-halo {
    fill: var(--sol-200);
  }

  .d-sol {
    fill: var(--sol-500);
  }

  .d-suelo {
    fill: var(--n700);
  }

  .d-suelo-claro {
    fill: var(--sol-300);
  }

  .d-cacao {
    fill: var(--cacao);
  }

  .d-pantalla {
    fill: var(--claro);
  }

  .d-pantalla-calida {
    fill: var(--sol-200);
  }

  .d-hueco {
    fill: var(--sol-100);
  }

  .d-reserva {
    fill: var(--sol-500);
  }

  .d-claro {
    fill: var(--claro);
  }
</style>
