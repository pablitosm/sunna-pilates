---
import Logo from './Logo.astro';
import CtaButton from './CtaButton.astro';
import MobileMenu from './vue/MobileMenu.vue';
import type { Ajustes, Home, Lang, Pagina } from '../lib/content';
import { idiomas, nombresIdioma, raizIdioma, urlPagina, whatsappUrl } from '../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
  lang?: Lang;
  /** Página actual: el selector de idioma lleva a la misma página en otro idioma. */
  pagina?: Pagina;
}
const { ajustes, home, lang = 'es', pagina } = Astro.props;
const actual = Astro.url.pathname;
const links = home.menu.map((m) => {
  const href = m.pagina ? urlPagina(lang, m.pagina) : `${raizIdioma(lang)}#${m.ancla}`;
  const hijos = (m.submenu ?? []).map((h) => {
    const hrefHijo = urlPagina(lang, h.pagina);
    return { texto: h.texto, href: hrefHijo, actual: hrefHijo === actual };
  });
  return { texto: m.texto, href, actual: href === actual || hijos.some((h) => h.actual), hijos };
});
const opcionesIdioma = idiomas.map((l) => ({
  codigo: l,
  nombre: nombresIdioma[l],
  href: urlPagina(l, pagina),
  actual: l === lang,
}));
---

<header class="cabecera" data-cabecera>
  <div class="cabecera__pildora">
    <a class="cabecera__logo" href={raizIdioma(lang)} aria-label={home.ui.irInicio}>
      <Logo label="SUNNA" />
    </a>

    <nav class="cabecera__nav" aria-label={home.ui.navegacion}>
      <ul role="list">
        {
          links.map((l) =>
            l.hijos.length ? (
              <li>
                <details class="submenu" data-submenu>
                  <summary class:list={{ 'es-actual': l.actual }}>
                    {l.texto}
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m2 3.75 3 3 3-3" />
                    </svg>
                  </summary>
                  <ul role="list" class="submenu__lista">
                    {l.hijos.map((h) => (
                      <li>
                        <a href={h.href} aria-current={h.actual ? 'page' : undefined}>
                          {h.texto}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={l.href} aria-current={l.actual ? 'page' : undefined}>
                  {l.texto}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <details class="idiomas" data-idiomas>
      <summary aria-label={home.ui.idioma}>
        <span aria-hidden="true">{lang.toUpperCase()}</span>
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m2 3.75 3 3 3-3" />
        </svg>
      </summary>
      <ul role="list" class="idiomas__lista">
        {
          opcionesIdioma.map((o) => (
            <li>
              <a
                href={o.href}
                hreflang={o.codigo}
                lang={o.codigo}
                aria-current={o.actual ? 'page' : undefined}
                data-elegir-idioma={o.codigo}
              >
                <span class="idiomas__codigo" aria-hidden="true">{o.codigo.toUpperCase()}</span>
                {o.nombre}
              </a>
            </li>
          ))
        }
      </ul>
    </details>

    <CtaButton ajustes={ajustes} home={home} corto tamano="compacto" class="cabecera__cta" />

    <MobileMenu
      client:media="(max-width: 68rem)"
      links={links}
      whatsapp={whatsappUrl(ajustes.contacto.whatsapp, home.ui.whatsappMensaje)}
      whatsappTexto={home.panel.whatsapp}
      instagram={ajustes.contacto.instagram}
      cerrar={home.panel.cerrar}
      abrirMenu={home.ui.abrirMenu}
      menu={home.ui.menu}
      navegacion={home.ui.navegacion}
      idiomaTitulo={home.ui.idioma}
      idiomas={opcionesIdioma}
    />
  </div>
</header>

<script>
  // Al elegir idioma se guarda en una cookie: el servidor (servidor/idioma.caddy)
  // la respeta y ya no redirige la portada según el idioma del navegador.
  document.querySelectorAll<HTMLElement>('[data-elegir-idioma]').forEach((a) => {
    a.addEventListener('click', () => {
      document.cookie = `sunna-idioma=${a.dataset.elegirIdioma ?? 'es'}; path=/; max-age=31536000; samesite=lax`;
    });
  });

  // Los desplegables (idioma y espacios) se cierran al pulsar fuera o con Escape.
  document.querySelectorAll<HTMLDetailsElement>('[data-idiomas], [data-submenu]').forEach((d) => {
    document.addEventListener('click', (e) => {
      if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
    d.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && d.open) {
        d.open = false;
        d.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  /* Barra de lado a lado, fija arriba: crema sólida y una línea fina debajo */
  .cabecera {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    background: var(--crema);
    border-bottom: 1px solid var(--linea);
  }

  /* El contenido, con el mismo ancho que el resto de la página (.envoltura) */
  .cabecera__pildora {
    display: flex;
    align-items: center;
    gap: 2rem;
    width: min(100% - 2 * var(--gutter), var(--ancho));
    margin-inline: auto;
    padding: 0.875rem 0;
  }

  .cabecera__logo {
    flex: none;
    display: block;
    height: 26px;
  }

  .cabecera__logo :global(.logo) {
    width: auto;
    height: 100%;
  }

  .cabecera__nav {
    margin-inline: 0.875rem auto;
  }

  /* Selector de idioma: el código actual; al pulsar, los cuatro idiomas */
  .idiomas {
    position: relative;
    flex: none;
  }

  .idiomas summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.5rem;
    padding: 0 0.875rem;
    border-radius: var(--r-pill);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--tinta);
    list-style: none;
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }

  .idiomas summary::-webkit-details-marker {
    display: none;
  }

  .idiomas summary:hover,
  .idiomas[open] summary {
    background: rgb(255 255 255 / 0.7);
  }

  .idiomas summary svg {
    transition: transform 0.25s var(--ease);
  }

  .idiomas[open] summary svg {
    transform: rotate(180deg);
  }

  .idiomas__lista {
    position: absolute;
    top: calc(100% + 0.625rem);
    right: 0;
    min-width: 12rem;
    padding: 0.375rem;
    border-radius: var(--r-s);
    background: var(--crema);
    border: 1px solid var(--n100);
    box-shadow: var(--sombra);
  }

  .idiomas__lista a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: calc(var(--r-s) - 0.375rem);
    font-size: 0.9375rem;
    color: var(--tinta);
    text-decoration: none;
  }

  .idiomas__lista a:hover {
    background: var(--n50);
  }

  .idiomas__lista a[aria-current='page'] {
    background: var(--n100);
  }

  .idiomas__codigo {
    width: 1.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--tinta-60);
  }

  .cabecera__nav a {
    white-space: nowrap;
  }


  .cabecera__nav ul {
    display: flex;
    align-items: center;
    gap: 1.625rem;
  }

  /* Enlaces y «Espacios» con la misma caja: quedan a la misma altura */
  .cabecera__nav > ul > li > a,
  .submenu summary {
    display: flex;
    align-items: center;
    height: 1.75rem;
    line-height: 1;
    /* Compensa el subrayado de abajo para que el texto quede centrado con el logo y el botón */
    padding-top: 3.5px;
  }

  .cabecera__nav a {
    padding-bottom: 2px;
    color: var(--tinta);
    font-size: 0.9375rem;
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    transition: border-color 0.22s var(--ease);
  }

  .cabecera__nav a:hover,
  .cabecera__nav a[aria-current='page'] {
    border-bottom-color: var(--n500);
  }

  /* Espacios: desplegable con reformer, luz roja y sauna */
  .submenu {
    position: relative;
  }

  .submenu summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding-bottom: 2px;
    border-bottom: 1.5px solid transparent;
    font-size: 0.9375rem;
    color: var(--tinta);
    white-space: nowrap;
    list-style: none;
    cursor: pointer;
    transition: border-color 0.22s var(--ease);
  }

  .submenu summary::-webkit-details-marker {
    display: none;
  }

  .submenu summary:hover,
  .submenu summary.es-actual {
    border-bottom-color: var(--n500);
  }

  .submenu summary svg {
    transition: transform 0.25s var(--ease);
  }

  .submenu[open] summary svg {
    transform: rotate(180deg);
  }

  .cabecera__nav .submenu__lista {
    display: grid;
    gap: 0;
  }

  .submenu__lista {
    position: absolute;
    top: calc(100% + 1.25rem);
    left: -1rem;
    min-width: 12rem;
    padding: 0.375rem;
    border-radius: var(--r-s);
    background: var(--crema);
    border: 1px solid var(--n100);
    box-shadow: var(--sombra);
  }

  .cabecera__nav .submenu__lista a {
    display: block;
    padding: 0.625rem 0.875rem;
    border: 0;
    border-radius: 10px;
  }

  .cabecera__nav .submenu__lista a:hover,
  .cabecera__nav .submenu__lista a[aria-current='page'] {
    background: var(--n50);
  }

  @media (max-width: 75rem) {
    .cabecera__pildora {
      gap: 1rem;
    }
    .cabecera__nav {
      margin-left: 0.25rem;
    }
    .cabecera__nav ul {
      gap: 1.125rem;
    }
  }

  /* Tableta: los enlaces pasan al menú; quedan idioma, botón y menú */
  @media (max-width: 68rem) {
    .cabecera__nav {
      display: none;
    }
    .idiomas {
      margin-left: auto;
    }
  }

  @media (max-width: 56.25rem) {
    .cabecera__pildora {
      padding: 0.625rem 0;
      justify-content: space-between;
    }
    .cabecera__nav,
    .idiomas,
    .cabecera :global(.cabecera__cta) {
      display: none;
    }
    .cabecera__logo {
      height: 22px;
    }
  }
</style>
