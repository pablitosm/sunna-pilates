---
import Glifo from '../Glifo.astro';
import type { Ajustes, Home } from '../../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { ajustes, home } = Astro.props;
const { comoFunciona: cf } = home;
// Datos prácticos junto al paso al que pertenecen: reservar (paso 2) y terminar la clase (paso 4)
const notasPaso: Record<number, string[]> = {
  1: [cf.datos.reserva, cf.datos.cancelacion],
  3: [cf.notaFinal],
};
const { horariosUrl, appUrl } = ajustes.reservas;
---

<section id="como-funciona" class="como seccion" aria-labelledby="como-titulo">
  <div class="envoltura">
    <h2 id="como-titulo" class="t-h2 como__titulo">{cf.titulo}</h2>

    <!-- Cuatro pasos en fila, con línea fina; sin tarjetas -->
    <ol role="list" class="pasos">
      {
        cf.pasos.map((paso, i) => (
          <li class="paso">
            <Glifo forma={paso.icono as any} tamano={44} class="paso__glifo" />
            <div>
              <h3 class="paso__titulo">
                <span class="paso__numero" aria-hidden="true">{i + 1}</span>
                <span class="solo-lectores">{home.ui.paso} {i + 1}. </span>
                {paso.titulo}
              </h3>
              <p class="paso__texto">{paso.texto}</p>
              {notasPaso[i] && (
                <ul role="list" class="paso__notas">
                  {notasPaso[i].filter(Boolean).map((n) => (
                    <li>{n}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <h3 class="horario__titulo">{cf.datos.horario.titulo}</h3>
    {cf.datos.horario.intro && <p class="horario__intro">{cf.datos.horario.intro}</p>}
    <div class="horario">
      {
        cf.datos.horario.fases.map((f, i) => (
          <div class:list={['fase', { 'fase--final': i > 0 }]}>
            <p class="etiqueta fase__etiqueta">{f.etiqueta}</p>
            {f.horas.map((h) => (
              <p class="fase__horas">{h}</p>
            ))}
            <p class:list={['fase__texto', { 'fase__texto--destacado': i === 0 }]}>{f.texto}</p>
          </div>
        ))
      }
    </div>
    {
      cf.datos.horario.franjas && (
        <div class="franjas">
          <p class="etiqueta franjas__titulo">{cf.datos.horario.franjas.titulo}</p>
          <ul role="list" class="franjas__lista">
            {cf.datos.horario.franjas.items.map((f) => (
              <li class:list={['franja', { 'franja--tranquila': f.tranquila }]}>
                <p class="franja__horas">{f.horas}</p>
                <p class="franja__texto">{f.texto}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      (horariosUrl || appUrl) && (
        <p class="enlaces">
          {horariosUrl && (
            <a class="enlace-flecha" href={horariosUrl} target="_blank" rel="noopener">
              {home.enlaces.horarios} →
            </a>
          )}
          {appUrl && (
            <a class="enlace-flecha" href={appUrl} target="_blank" rel="noopener">
              {home.enlaces.app} →
            </a>
          )}
        </p>
      )
    }
  </div>
</section>

<style>
  .como {
    background: var(--tostado);
  }

  .como__titulo {
    margin-bottom: var(--titulo-contenido);
  }

  /* Los cuatro pasos: columnas con línea fina arriba */
  .pasos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 1.75rem;
  }

  .paso {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linea-fuerte);
  }

  .paso :global(.paso__glifo) {
    color: var(--n700);
  }

  .paso__titulo {
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .paso__numero {
    margin-right: 0.375rem;
    color: var(--n700);
    font-variant-numeric: tabular-nums;
  }

  .paso__texto {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--tinta-60);
  }

  /* Datos prácticos bajo su paso: letra pequeña con una línea fina encima */
  .paso__notas {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 0.875rem;
    border-top: 1px dashed var(--linea-fuerte);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--tinta-60);
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
  }

  .horario__titulo {
    margin: 3.25rem 0 1.25rem;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .horario__intro {
    max-width: 56ch;
    margin: -0.25rem 0 2rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--tinta-60);
  }

  /* Cómo se llena el día: tres franjas, la tranquila en oliva */
  /* Mismo ancho que las tarjetas del horario (sin panel alrededor) */
  .franjas {
    margin-top: 2.5rem;
  }

  .franjas__titulo {
    margin-bottom: 1.625rem;
  }

  .franjas__lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .franja {
    padding: 1.5rem 1.625rem 1.625rem;
    border-radius: 14px;
    background: var(--n50);
  }

  .franja__horas {
    font-size: clamp(1.25rem, 0.9rem + 1vw, 1.625rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .franja__texto {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--tinta-60);
  }

  .franja--tranquila {
    background: var(--oliva);
  }

  .franja--tranquila .franja__horas,
  .franja--tranquila .franja__texto {
    color: var(--oliva-tinta);
  }

  .horario {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .fase {
    padding: 2.125rem 2.25rem 2.375rem;
    border-radius: var(--r-l);
    background: var(--n50);
  }

  .fase--final {
    background: var(--crema);
    border: 1px dashed var(--linea-fuerte);
  }

  .fase__etiqueta {
    margin-bottom: 1.25rem;
  }

  .fase__horas {
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .fase__horas + .fase__horas {
    margin-top: 0.375rem;
  }

  .fase__texto {
    margin-top: 0.875rem;
    font-size: 0.9375rem;
    color: var(--tinta-60);
  }

  /* Las primeras semanas siempre hay alguien de SUNNA: se lee de un vistazo */
  .fase__texto--destacado {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: var(--r-s);
    background: var(--n100);
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--tinta);
  }

  .fase__texto--destacado::before {
    content: '';
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: var(--n500);
    box-shadow: 0 0 0 5px rgb(255 130 53 / 0.22);
    animation: fase-respira 4.5s ease-in-out infinite;
  }

  /* Respira despacio, como alguien presente en la sala */
  @keyframes fase-respira {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 4px rgb(255 130 53 / 0.24);
    }
    50% {
      transform: scale(1.12);
      box-shadow: 0 0 0 9px rgb(255 130 53 / 0.08);
    }
  }

  @media (max-width: 64rem) {
    .pasos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Móvil: pasos en filas compactas (icono a la izquierda) */
  @media (max-width: 40rem) {
    .pasos {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .paso {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1rem;
      padding: 1.125rem 0;
    }

    .paso :global(.paso__glifo) {
      width: 36px;
      height: 36px;
    }

    .horario,
    .franjas__lista {
      grid-template-columns: 1fr;
    }

  }
</style>
