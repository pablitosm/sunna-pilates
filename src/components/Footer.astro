---
import Logo from './Logo.astro';
import { direccionCompleta, idiomaDe, mapsUrl, urlLegal, urlPagina, whatsappUrl, type Ajustes, type Home } from '../lib/content';
import { tramosCortos } from '../lib/horario';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { ajustes, home } = Astro.props;
const lang = idiomaDe(Astro.currentLocale);
const wa = whatsappUrl(ajustes.contacto.whatsapp, home.ui.whatsappMensaje);
// Las páginas propias del menú (cada espacio y los precios)
const paginas = home.menu
  .flatMap((m) => m.submenu ?? (m.pagina ? [{ texto: m.texto, pagina: m.pagina }] : []))
  .map((m) => ({ texto: m.texto, href: urlPagina(lang, m.pagina) }));
const { contacto } = ajustes;
const hayMedicion = Boolean(ajustes.medicion.googleAnalyticsId || ajustes.medicion.metaPixelId);
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="envoltura">
    <div class="pie__firma">
      <Logo version="crema" label="SUNNA" />
    </div>

    <div class="pie__rejilla">
      <div class="pie__col">
        <h2 class="etiqueta pie__titulo">{home.ui.pieEstudio}</h2>
        <a href={mapsUrl(ajustes)} target="_blank" rel="noopener">{direccionCompleta(ajustes)}</a>
      </div>

      {
        paginas.length > 0 && home.ui.pieEspacios && (
          <div class="pie__col">
            <h2 class="etiqueta pie__titulo">{home.ui.pieEspacios}</h2>
            {paginas.map((p) => (
              <a href={p.href}>{p.texto}</a>
            ))}
          </div>
        )
      }

      <div class="pie__col">
        <h2 class="etiqueta pie__titulo">{home.ui.pieContacto}</h2>
        {wa && <a href={wa} target="_blank" rel="noopener">WhatsApp</a>}
        {contacto.instagram && <a href={contacto.instagram} target="_blank" rel="noopener">Instagram</a>}
        {ajustes.reservas.appUrl && <a href={ajustes.reservas.appUrl} target="_blank" rel="noopener">{home.enlaces.app}</a>}
        {contacto.telefonoAyuda && <a href={`tel:${contacto.telefonoAyuda.replace(/\s/g, '')}`}>{contacto.telefonoAyuda}</a>}
      </div>

      <div class="pie__col">
        <h2 class="etiqueta pie__titulo">{home.pie.horarioTitulo}</h2>
        {tramosCortos(ajustes).map((h) => <span>{h}</span>)}
      </div>

      <div class="pie__col">
        <h2 class="etiqueta pie__titulo">{home.ui.pieLegal}</h2>
        {home.pie.legal.map((l) => <a href={urlLegal(lang, l.pagina)}>{l.texto}</a>)}
        {
          hayMedicion && (
            <button type="button" class="pie__cookies" data-open-cookies>
              {home.pie.cookies}
            </button>
          )
        }
      </div>
    </div>

    <div class="pie__base">
      <span>© {anio} SUNNA PILATES</span>
      <span>{ajustes.direccion.ciudad}</span>
    </div>
  </div>
</footer>

<style>
  .pie {
    background: var(--pie-fondo, var(--n900));
    color: var(--crema);
    padding: clamp(3.5rem, 2rem + 4vw, 5rem) 0 calc(3.5rem + env(safe-area-inset-bottom));
  }

  @media (max-width: 56.25rem) {
    .pie {
      padding-bottom: calc(7rem + env(safe-area-inset-bottom));
    }
  }

  .pie__firma {
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .pie__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: 2rem;
    padding-bottom: 2.75rem;
    border-bottom: 1px solid rgb(var(--crema-rgb) / 0.25);
  }

  .pie__col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 1rem;
    line-height: 1.45;
  }

  .pie__titulo {
    color: rgb(var(--crema-rgb) / 0.65);
  }

  .pie a {
    color: var(--crema);
    text-decoration: none;
  }

  .pie a:hover {
    text-decoration: underline;
    text-decoration-color: rgb(var(--crema-rgb) / 0.5);
  }

  .pie__cookies {
    padding: 0;
    border: 0;
    background: none;
    color: var(--crema);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pie__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.75rem;
    font-size: 0.8125rem;
    color: rgb(var(--crema-rgb) / 0.6);
  }

  .pie :focus-visible {
    outline-color: var(--n200);
  }

  @media (max-width: 56.25rem) {
    .pie__rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .pie__rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>
