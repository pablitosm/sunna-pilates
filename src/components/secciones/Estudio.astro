---
import PhotoSlot from '../PhotoSlot.astro';
import Glifo from '../Glifo.astro';
import { mapsEmbedUrl, mapsUrl, type Ajustes, type Home } from '../../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { ajustes, home } = Astro.props;
const { estudio } = home;
const d = ajustes.direccion;
---

<section id="estudio" class="estudio seccion" aria-labelledby="estudio-titulo">
  <div class="envoltura">
    <div class="cabeza-seccion">
      <h2 id="estudio-titulo" class="t-h2">{estudio.titulo}</h2>
    </div>

    <ul role="list" class="galeria con-trazado" data-trazar>
      {
        estudio.espacios.map((e, i) => (
          <li class="portal">
            {e.foto ? (
              <PhotoSlot foto={e.foto} class="portal__arco" sizes="(min-width: 56rem) 25vw, 50vw" />
            ) : (
              <div class:list={['portal__arco', `portal__arco--${e.tono}`]} aria-hidden="true">
                <Glifo forma={e.icono as any} tamano={76} indice={i} />
              </div>
            )}
            <p class="portal__pie">{e.texto}</p>
          </li>
        ))
      }
    </ul>

    <div class="lugar">
      <div class="mapa" data-mapa data-pulso>
        <div class="mapa__dibujo" aria-hidden="true">
          <span class="mapa__franja"></span>
          <span class="mapa__halo"></span>
          <span class="mapa__punto"></span>
        </div>
        <div class="mapa__accion">
          <button type="button" class="mapa__boton" data-mapa-cargar data-src={mapsEmbedUrl(ajustes)}>
            {estudio.mapa.boton}
          </button>
          <p class="mapa__aviso">{estudio.mapa.aviso}</p>
        </div>
      </div>

      <div class="lugar__datos">
        <div>
          <p class="etiqueta lugar__etiqueta">{estudio.mapa.direccion}</p>
          <address class="lugar__direccion">
            {d.calle}
            <br />
            {d.codigoPostal} {d.ciudad}
          </address>
        </div>
        {
          d.comoLlegar && (
            <div>
              <p class="etiqueta lugar__etiqueta">{estudio.mapa.comoLlegar}</p>
              <p class="lugar__direccion">{d.comoLlegar}</p>
            </div>
          )
        }
        <a class="lugar__enlace" href={mapsUrl(ajustes)} target="_blank" rel="noopener">
          {estudio.mapa.abrir}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // El mapa de Google solo se carga si la persona lo pide (evita cookies de terceros).
  document.querySelectorAll<HTMLButtonElement>('[data-mapa-cargar]').forEach((boton) => {
    boton.addEventListener('click', () => {
      const mapa = boton.closest('[data-mapa]');
      if (!mapa || !boton.dataset.src) return;
      const iframe = document.createElement('iframe');
      iframe.src = boton.dataset.src;
      iframe.title = 'Mapa: ubicación de SUNNA';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'mapa__iframe';
      mapa.replaceChildren(iframe);
    });
  });
</script>

<style>
  /* Galería de portales */
  .galeria {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.75rem;
  }

  .portal :global(.portal__arco) {
    display: grid;
    place-items: center;
    height: clamp(20rem, 14rem + 16vw, 27.5rem);
    border-radius: 180px 180px var(--r-l) var(--r-l);
    overflow: hidden;
  }

  .portal__arco--claro {
    background: linear-gradient(180deg, var(--n50), var(--tostado));
  }

  .portal__arco--medio {
    background: linear-gradient(180deg, var(--n100), var(--n200));
  }

  .portal__arco--sol {
    background: linear-gradient(180deg, var(--n100), var(--n200));
  }

  .portal__arco--tinta {
    background: linear-gradient(180deg, var(--tostado), var(--n100));
  }

  /* El arco crece de abajo arriba al entrar; el contenido entra con parallax 8 % */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .portal :global(.portal__arco) {
        animation: portal-crece linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
      .portal :global(.portal__arco > *) {
        animation: portal-parallax linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }

  @keyframes portal-crece {
    from {
      clip-path: inset(45% 0 0 0 round 180px 180px 28px 28px);
    }
    to {
      clip-path: inset(0 0 0 0 round 180px 180px 28px 28px);
    }
  }

  @keyframes portal-parallax {
    from {
      transform: translateY(8%);
    }
    to {
      transform: translateY(-8%);
    }
  }

  .portal__pie {
    margin-top: 1.125rem;
    font-size: 1rem;
    line-height: 1.45;
  }

  /* Mapa en tonos de paleta + dirección */
  .lugar {
    display: flex;
    gap: 1.75rem;
    align-items: stretch;
    margin-top: clamp(4rem, 3rem + 3vw, 7.5rem);
  }

  .mapa {
    position: relative;
    flex: 1;
    min-height: 28.75rem;
    border-radius: var(--r-l);
    overflow: hidden;
    background: var(--tostado);
  }

  .mapa__dibujo > span {
    position: absolute;
    display: block;
  }



  .mapa__franja {
    left: 0;
    right: 0;
    bottom: 0;
    height: 120px;
    background: var(--n100);
  }

  .mapa__halo {
    left: 50%;
    top: 46%;
    width: 220px;
    height: 220px;
    margin: -110px 0 0 -110px;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgb(255 130 53 / 0.55), rgb(255 196 154 / 0));
  }

  .mapa__punto {
    left: 50%;
    top: 46%;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 999px;
    background: var(--n500);
    box-shadow: 0 0 0 4px rgb(253 246 238 / 0.9);
  }

  .mapa__accion {
    position: absolute;
    left: 1.5rem;
    bottom: 1.5rem;
    right: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .mapa__boton {
    padding: 0.625rem 1rem;
    border: 0;
    border-radius: var(--r-s);
    background: rgb(253 246 238 / 0.85);
    font: 400 0.9375rem var(--font);
    color: var(--tinta);
    cursor: pointer;
  }

  .mapa__aviso {
    font-size: 0.8125rem;
    color: var(--tinta-60);
  }

  /* El punto pulsa una vez al entrar */
  .mapa.pulsado .mapa__punto {
    animation: pulso 1.2s var(--ease) 1;
  }

  @keyframes pulso {
    from {
      box-shadow:
        0 0 0 4px rgb(253 246 238 / 0.9),
        0 0 0 4px rgb(255 130 53 / 0.5);
    }
    to {
      box-shadow:
        0 0 0 4px rgb(253 246 238 / 0.9),
        0 0 0 44px rgb(255 130 53 / 0);
    }
  }

  .mapa :global(.mapa__iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .lugar__datos {
    flex: 0 0 26.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.625rem;
    padding: 2.75rem 2.375rem;
    border-radius: var(--r-l);
    background: var(--n50);
  }

  .lugar__etiqueta {
    margin-bottom: 0.5rem;
  }

  .lugar__direccion {
    font-size: 1.125rem;
    line-height: 1.6;
    font-style: normal;
  }

  .lugar__enlace {
    margin-top: auto;
    font-size: 1.0625rem;
    color: var(--n900);
  }

  @media (max-width: 56.25rem) {
    .galeria {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1rem;
    }
    .portal :global(.portal__arco) {
      height: 16rem;
      border-radius: 120px 120px var(--r-s) var(--r-s);
    }
    .lugar {
      flex-direction: column;
    }
    .lugar__datos {
      flex-basis: auto;
    }
    .mapa {
      min-height: 20rem;
    }
  }
</style>
