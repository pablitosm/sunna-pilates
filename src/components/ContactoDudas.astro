---
/*
 * «¿Aún tienes preguntas?»: correo e Instagram (ajustes.yaml → contacto).
 * Lo usan el FAQ (bajo el título) y la página de precios (bajo las tarjetas).
 */
import Icon from './Icon.astro';
import type { Ajustes } from '../lib/content';

interface Props {
  ajustes: Ajustes;
  titulo: string;
  texto?: string;
  /** en-linea: título y canales en una fila (bajo las tarjetas de precios) */
  forma?: 'columna' | 'en-linea';
  class?: string;
}
const { ajustes, titulo, texto, forma = 'columna', class: className } = Astro.props;
const { email, instagram } = ajustes.contacto;
const usuarioIg = instagram.replace(/\/+$/, '').split('/').pop();
---

{
  (email || instagram) && (
    <div class:list={['contacto', `contacto--${forma}`, className]}>
      <div>
        <p class="contacto__titulo">{titulo}</p>
        {texto && <p class="contacto__texto">{texto}</p>}
      </div>
      <ul role="list" class="contacto__canales">
        {email && (
          <li>
            <a href={`mailto:${email}`}>
              <Icon name="correo" size={16} />
              {email}
            </a>
          </li>
        )}
        {instagram && (
          <li>
            <a href={instagram} target="_blank" rel="noopener">
              <Icon name="instagram" size={16} />@{usuarioIg}
            </a>
          </li>
        )}
      </ul>
    </div>
  )
}

<style>
  .contacto {
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea-fuerte);
  }

  .contacto--en-linea {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .contacto__titulo {
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .contacto__texto {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--tinta-60);
  }

  .contacto__canales {
    display: grid;
    gap: 0.375rem;
    margin-top: 0.875rem;
  }

  .contacto--en-linea .contacto__canales {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 0;
  }

  .contacto__canales a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--n900);
    text-decoration: underline;
    text-decoration-color: var(--n300);
    text-underline-offset: 0.25em;
  }

  .contacto__canales a:hover {
    text-decoration-color: var(--n900);
  }

  .contacto__canales :global(svg) {
    color: var(--n700);
  }
</style>
