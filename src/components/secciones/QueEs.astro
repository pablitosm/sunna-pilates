---
import { acentuar } from '../../lib/acento';
import Glifo from '../Glifo.astro';
import type { Home } from '../../lib/content';

interface Props {
  home: Home;
}
const { queEs } = Astro.props.home;
---

<section class="que-es seccion" aria-labelledby="que-es-titulo">
  <div class="envoltura">
    <div class="cabeza-seccion">
      <h2 id="que-es-titulo" class="t-h2" set:html={acentuar(queEs.titulo)} />
    </div>

    <ul role="list" class="ideas">
      {
        queEs.ideas.map((idea, i) => (
          <li class="idea">
            <Glifo forma={idea.icono as any} tamano={52} />
            <h3 class="idea__titulo">{idea.titulo}</h3>
            <p class="idea__texto">{idea.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ideas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem 2.5rem;
    padding-block: 2.75rem;
    border-top: 1px solid rgb(var(--n200-rgb) / 0.9);
    border-bottom: 1px solid rgb(var(--n200-rgb) / 0.9);
  }

  .idea {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .idea__titulo {
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .idea__texto {
    max-width: 30ch;
    font-size: 1rem;
    color: var(--tinta-60);
    margin-top: -0.375rem;
  }

  @media (max-width: 56.25rem) {
    .ideas {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
