---
/*
 * Móvil: barra fija inferior con el botón principal (siempre a mano) y WhatsApp.
 * Escritorio: solo el botón flotante de WhatsApp.
 */
import CtaButton from './CtaButton.astro';
import Icon from './Icon.astro';
import { whatsappUrl, type Ajustes, type Home } from '../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { ajustes, home } = Astro.props;
const wa = whatsappUrl(ajustes.contacto.whatsapp, home.ui.whatsappMensaje);
---

<div class="barra" data-barra-movil>
  <div class="barra__pildora">
    <CtaButton ajustes={ajustes} home={home} corto class="barra__cta" />
    {
      wa && (
        <a class="barra__wa" href={wa} target="_blank" rel="noopener" aria-label={home.panel.whatsapp}>
          <Icon name="whatsapp" size={22} />
        </a>
      )
    }
  </div>
</div>

{
  wa && (
    <a class="wa-flotante" href={wa} target="_blank" rel="noopener" aria-label={home.panel.whatsapp}>
      <Icon name="whatsapp" size={26} />
    </a>
  )
}


<style>
  .barra {
    display: none;
  }

  @media (max-width: 56.25rem) {
    .barra {
      display: block;
      position: fixed;
      inset: auto 0 0;
      z-index: 35;
      padding: 0.625rem var(--gutter) calc(0.625rem + env(safe-area-inset-bottom));
      background: var(--crema);
      border-top: 1px solid var(--linea);
      transition: transform 0.4s var(--ease);
    }
    :global(body.panel-abierto) .barra {
      transform: translateY(calc(100% + 1rem));
    }
  }

  .barra__pildora {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .barra__pildora :global(.barra__cta) {
    flex: 1;
    min-width: 0;
    justify-content: space-between;
  }

  /* Con WhatsApp al lado, el botón se compacta para que el texto quepa en una línea */
  .barra__pildora:has(.barra__wa) :global(.barra__cta) {
    --alto: 3.25rem;
    --circulo: 3.25rem;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  /* Móviles muy estrechos: mejor dos líneas equilibradas que cortar el texto */
  @media (max-width: 23rem) {
    .barra__pildora:has(.barra__wa) :global(.barra__cta) {
      white-space: normal;
      line-height: 1.15;
      text-wrap: balance;
    }
  }

  .barra__wa,
  .wa-flotante {
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 50%;
    background: var(--n50);
    color: var(--n900);
    box-shadow: inset 0 0 0 1px var(--n200);
  }

  .barra__wa {
    width: 3.25rem;
    height: 3.25rem;
  }

  .wa-flotante {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 30;
    width: 3.75rem;
    height: 3.75rem;
    box-shadow:
      var(--sombra-s),
      inset 0 0 0 1px var(--n200);
    transition: transform 0.4s var(--ease);
  }

  .wa-flotante:hover {
    transform: translateY(-3px);
  }

  @media (max-width: 56.25rem) {
    .wa-flotante {
      display: none;
    }
  }
</style>
