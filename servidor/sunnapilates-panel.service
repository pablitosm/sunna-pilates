[Unit]
Description=Panel de administración de sunnapilates.es
After=network.target postgresql.service

[Service]
EnvironmentFile=/etc/sunnapilates-panel.env
ExecStart=/usr/bin/python3 /opt/sunnapilates-panel/panel.py
Restart=on-failure
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
