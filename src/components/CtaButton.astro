---
/*
 * Botón firma de reserva, con el vidrio de .boton-sol (global.css).
 * Abierto: lleva a la página de la primera sesión gratis. Preapertura: abre el
 * panel de lista de espera (sin JavaScript, sigue el enlace).
 */
import Icon from './Icon.astro';
import { ctaEsFundador, ctaHref, idiomaDe, type Ajustes, type Home } from '../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
  corto?: boolean;
  tamano?: 'normal' | 'compacto';
  class?: string;
}
const { ajustes, home, corto = false, tamano = 'normal', class: className } = Astro.props;
const textos = corto ? home.botones.principalCorto : home.botones.principal;
// Abierto y con plazas de fundador: invita a hacerse socio/a fundador/a en vez de a la primera sesión.
const label = (ctaEsFundador(ajustes) && textos.fundador) || textos[ajustes.estado];
const href = ctaHref(ajustes, idiomaDe(Astro.currentLocale));
const abrePanel = ajustes.estado === 'preapertura';
---

<a
  class:list={['cta', 'boton-sol', `cta--${tamano}`, className]}
  href={href}
  data-open-booking={abrePanel ? '' : undefined}
>
  <span class="cta__texto">{label}</span>
  <span class="cta__flecha" aria-hidden="true"><Icon name="flecha" size={tamano === 'compacto' ? 16 : 20} /></span>
</a>

<style>
  /* El color y el vidrio vienen de .boton-sol (global.css); aquí, forma y tamaño */
  .cta {
    --alto: 3.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    height: var(--alto);
    padding: 0 1.75rem 0 2rem;
    border-radius: var(--r-pill);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .cta--compacto {
    --alto: 2.875rem;
    gap: 0.625rem;
    padding: 0 1.25rem 0 1.5rem;
    font-size: 0.9375rem;
  }

  /* La flecha avanza al entrar y vuelve con un pequeño rebote al salir */
  .cta__flecha {
    display: grid;
    place-items: center;
    transition: transform 0.7s linear(0, 0.62 12%, 1.12 30%, 1.04 45%, 0.98 62%, 1);
  }

  @media (hover: hover) {
    .cta:hover .cta__flecha {
      transform: translateX(4px);
      transition: transform 0.3s var(--ease);
    }
  }

  @media (max-width: 40rem) {
    .cta--normal {
      --alto: 3.5rem;
      padding-left: 1.5rem;
      font-size: 1rem;
      white-space: normal;
    }
    .cta--normal .cta__flecha {
      margin-left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta__flecha {
      transition: none;
    }
  }
</style>
