---
/* Foto real del estudio, optimizada (AVIF/WebP, varios tamaños). */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  foto: { imagen: ImageMetadata; alt: string };
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { foto, sizes = '(min-width: 64rem) 40vw, 100vw', loading = 'lazy', class: className } = Astro.props;
---

<figure class:list={['foto', className]}>
  <Picture
    src={foto.imagen}
    alt={foto.alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1800]}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
  />
</figure>

<style>
  .foto {
    position: relative;
    overflow: hidden;
    background: var(--tostado);
  }

  .foto :global(picture),
  .foto :global(img) {
    width: 100%;
    height: 100%;
  }

  .foto :global(img) {
    object-fit: cover;
  }
</style>
