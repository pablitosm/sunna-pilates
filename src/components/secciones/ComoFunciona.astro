---
import type { Ajustes, Home } from '../../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { home } = Astro.props;
const { comoFunciona: cf } = home;
// Datos prácticos de la reserva: van juntos en un desplegable bajo las tres ideas
const detalles = [cf.datos.reserva, cf.datos.cancelacion, cf.notaFinal].filter(Boolean);
---

<section id="como-funciona" class="como seccion" aria-labelledby="como-titulo">
  <div class="envoltura">
    <h2 id="como-titulo" class="t-h2 como__titulo">{cf.titulo}</h2>

    <!-- Tres ideas en filas, entre líneas finas: la frase grande a la izquierda y
         la explicación a la derecha. Sin iconos ni números: no son pasos -->
    <ul role="list" class="ideas">
      {
        cf.pasos.map((paso) => (
          <li class="idea">
            <h3 class="idea__titulo">{paso.titulo}</h3>
            <p class="idea__texto">{paso.texto}</p>
          </li>
        ))
      }
    </ul>

    <!-- Letra pequeña de la reserva: una fila más de la lista, cerrada por defecto.
         Al abrir, los datos caen en la columna de las explicaciones -->
    {
      detalles.length > 0 && (
        <details class="detalles">
          <summary>
            <span class="detalles__titulo">{home.ui.detallesReserva}</span>
            <span class="detalles__signo" aria-hidden="true" />
          </summary>
          <div class="detalles__cuerpo">
            <ul role="list" class="detalles__lista">
              {detalles.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </div>
        </details>
      )
    }
  </div>
</section>

<style>
  .como__titulo {
    margin-bottom: var(--titulo-contenido);
  }

  /* Tres ideas en filas: frase grande a la izquierda, explicación a la derecha */
  .idea {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 0.75rem clamp(2rem, 1rem + 4vw, 6rem);
    align-items: baseline;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem) 0;
    border-top: 1px solid var(--linea-fuerte);
  }

  .idea__titulo {
    font-size: var(--t-h3);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .idea__texto {
    max-width: 46ch;
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--tinta-60);
  }

  /* Detalles de la reserva: la última fila de la lista, con un círculo + que gira a × al abrir */
  .detalles {
    border-block: 1px solid var(--linea-fuerte);
  }

  .detalles summary,
  .detalles__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 0.75rem clamp(2rem, 1rem + 4vw, 6rem);
  }

  .detalles summary {
    align-items: center;
    padding: clamp(1.25rem, 0.9rem + 1vw, 1.625rem) 0;
    cursor: pointer;
    list-style: none;
  }

  .detalles summary::-webkit-details-marker {
    display: none;
  }

  .detalles__titulo {
    font-size: var(--t-h3);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--tinta-60);
    transition: color 0.2s var(--ease);
  }

  .detalles summary:hover .detalles__titulo,
  .detalles[open] .detalles__titulo {
    color: var(--tinta);
  }

  .detalles__signo {
    position: relative;
    justify-self: end;
    width: 2.5rem;
    aspect-ratio: 1;
    border: 1.5px solid var(--n700);
    border-radius: 50%;
    transition:
      transform 0.25s var(--ease),
      background-color 0.2s var(--ease);
  }

  .detalles__signo::before,
  .detalles__signo::after {
    content: '';
    position: absolute;
    inset: 50% 0.6875rem auto;
    height: 1.5px;
    margin-top: -0.75px;
    background: var(--n700);
  }

  .detalles__signo::after {
    transform: rotate(90deg);
  }

  .detalles summary:hover .detalles__signo {
    background: var(--n50);
  }

  .detalles[open] .detalles__signo {
    transform: rotate(45deg);
  }

  /* Los datos, en la columna de las explicaciones, con raya naranja */
  .detalles__lista {
    grid-column: 2;
    display: grid;
    gap: 0.75rem;
    max-width: 46ch;
    padding-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--tinta-60);
  }

  .detalles__lista li {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
  }

  .detalles__lista li::before {
    content: '—';
    color: var(--n700);
  }

  @media (max-width: 56.25rem) {
    .detalles summary {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .detalles__cuerpo {
      grid-template-columns: 1fr;
    }

    .detalles__lista {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .detalles__signo {
      transition: none;
    }
  }

  /* Tableta y móvil: la explicación baja debajo de su frase */
  @media (max-width: 56.25rem) {
    .idea {
      grid-template-columns: 1fr;
    }
  }
</style>
