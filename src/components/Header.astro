---
import Logo from './Logo.astro';
import CtaButton from './CtaButton.astro';
import MobileMenu from './vue/MobileMenu.vue';
import type { Ajustes, Home, Lang, Pagina } from '../lib/content';
import { idiomas, nombresIdioma, raizIdioma, urlPagina, whatsappUrl } from '../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
  lang?: Lang;
  /** Página actual: el selector de idioma lleva a la misma página en otro idioma. */
  pagina?: Pagina;
}
const { ajustes, home, lang = 'es', pagina } = Astro.props;
const actual = Astro.url.pathname;
const links = home.menu.map((m) => {
  const href = m.pagina ? urlPagina(lang, m.pagina) : `${raizIdioma(lang)}#${m.ancla}`;
  const hijos = (m.submenu ?? []).map((h) => {
    const hrefHijo = urlPagina(lang, h.pagina);
    return { texto: h.texto, descripcion: h.descripcion, href: hrefHijo, actual: hrefHijo === actual };
  });
  return { texto: m.texto, href, actual: href === actual || hijos.some((h) => h.actual), hijos };
});
const opcionesIdioma = idiomas.map((l) => ({
  codigo: l,
  nombre: nombresIdioma[l],
  href: urlPagina(l, pagina),
  actual: l === lang,
}));
---

<header class="cabecera" data-cabecera>
  <div class="cabecera__pildora">
    <a class="cabecera__logo" href={raizIdioma(lang)} aria-label={home.ui.irInicio}>
      <Logo label="SUNNA" />
    </a>

    <nav class="cabecera__nav" aria-label={home.ui.navegacion}>
      <ul role="list">
        {
          links.map((l) =>
            l.hijos.length ? (
              <li>
                <details class="submenu" data-submenu>
                  <summary class:list={{ 'es-actual': l.actual }}>
                    {l.texto}
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m2 3.75 3 3 3-3" />
                    </svg>
                  </summary>
                  <div class="desplegable submenu__panel">
                    <ul role="list" class="submenu__lista">
                      {l.hijos.map((h, i) => (
                        <li class:list={{ 'submenu__destacado': i === 0 }}>
                          <a href={h.href} aria-current={h.actual ? 'page' : undefined} class:list={[i === 0 ? 'destacado' : 'opcion']}>
                            {i === 0 && (
                              <svg class="destacado__arco" width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
                                <path class="destacado__arco-marco" d="M6 34V18a12 12 0 0 1 24 0v16z" />
                                <path class="destacado__arco-luz" d="M10 34V18.5a8 8 0 0 1 16 0V34z" />
                                <circle class="destacado__arco-sol" cx="18" cy="22" r="4.5" />
                              </svg>
                            )}
                            <span class="opcion__titulo">{h.texto}</span>
                            {h.descripcion && <span class="opcion__texto">{h.descripcion}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              </li>
            ) : (
              <li>
                <a href={l.href} aria-current={l.actual ? 'page' : undefined}>
                  {l.texto}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <details class="idiomas" data-idiomas>
      <summary aria-label={`${home.ui.idioma}: ${nombresIdioma[lang]}`}>
        <span aria-hidden="true">{lang.toUpperCase()}</span>
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m2 3.75 3 3 3-3" />
        </svg>
      </summary>
      <div class="desplegable idiomas__panel">
        <ul role="list" class="idiomas__lista">
          {
            opcionesIdioma.map((o) => (
              <li>
                <a
                  class="opcion"
                  href={o.href}
                  hreflang={o.codigo}
                  lang={o.codigo}
                  aria-current={o.actual ? 'page' : undefined}
                  data-elegir-idioma={o.codigo}
                >
                  <span class="opcion__titulo">{o.nombre}</span>
                  <span class="opcion__texto" aria-hidden="true">{o.codigo.toUpperCase()}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </details>

    <CtaButton ajustes={ajustes} home={home} corto tamano="compacto" class="cabecera__cta" />

    <MobileMenu
      client:media="(max-width: 68rem)"
      links={links}
      whatsapp={whatsappUrl(ajustes.contacto.whatsapp, home.ui.whatsappMensaje)}
      whatsappTexto={home.panel.whatsapp}
      instagram={ajustes.contacto.instagram}
      cerrar={home.panel.cerrar}
      abrirMenu={home.ui.abrirMenu}
      menu={home.ui.menu}
      navegacion={home.ui.navegacion}
      idiomaTitulo={home.ui.idioma}
      idiomas={opcionesIdioma}
      inicio={raizIdioma(lang)}
      irInicio={home.ui.irInicio}
    >
      <!-- El logo, en el mismo sitio que en la cabecera mientras el menú está abierto -->
      <Logo label="SUNNA" />
    </MobileMenu>
  </div>
</header>

<script>
  // Al elegir idioma se guarda en una cookie: el servidor (servidor/idioma.caddy)
  // la respeta y ya no redirige la portada según el idioma del navegador.
  document.querySelectorAll<HTMLElement>('[data-elegir-idioma]').forEach((a) => {
    a.addEventListener('click', () => {
      document.cookie = `sunna-idioma=${a.dataset.elegirIdioma ?? 'es'}; path=/; max-age=31536000; samesite=lax`;
    });
  });

  // Desplegables (idioma y espacios): espacios se abre al pasar el ratón o al
  // pulsar; el idioma, solo al pulsar. Solo uno a la vez, y se cierran con una animación corta al salir, al pulsar
  // fuera o con Escape.
  const desplegables = [...document.querySelectorAll<HTMLDetailsElement>('[data-idiomas], [data-submenu]')];
  const conRaton = window.matchMedia('(hover: hover) and (pointer: fine)');
  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
  const temporizadores = new WeakMap<HTMLDetailsElement, number>();

  const abrir = (d: HTMLDetailsElement) => {
    clearTimeout(temporizadores.get(d));
    desplegables.forEach((otro) => otro !== d && cerrar(otro, true));
    d.removeAttribute('data-cerrando');
    d.open = true;
  };

  const cerrar = (d: HTMLDetailsElement, alInstante = false) => {
    clearTimeout(temporizadores.get(d));
    if (!d.open) return;
    if (alInstante || sinMovimiento.matches) {
      d.removeAttribute('data-cerrando');
      d.open = false;
      return;
    }
    d.setAttribute('data-cerrando', '');
    temporizadores.set(
      d,
      window.setTimeout(() => {
        d.removeAttribute('data-cerrando');
        d.open = false;
      }, 180),
    );
  };

  desplegables.forEach((d) => {
    const summary = d.querySelector('summary');
    // Al pasar el ratón se abre; el clic que suele venir justo después no debe cerrarlo
    let abiertoAlPasar = 0;
    summary?.addEventListener('click', (e) => {
      e.preventDefault();
      if (performance.now() - abiertoAlPasar < 400) return;
      if (d.open && !d.hasAttribute('data-cerrando')) cerrar(d);
      else abrir(d);
    });
    // El idioma no se abre al pasar por encima: hay que pulsarlo
    const alPasar = !d.hasAttribute('data-idiomas');
    d.addEventListener('mouseenter', () => {
      if (!alPasar || !conRaton.matches) return;
      if (!d.open) abiertoAlPasar = performance.now();
      abrir(d);
    });
    d.addEventListener('mouseleave', () => {
      if (!alPasar || !conRaton.matches) return;
      temporizadores.set(d, window.setTimeout(() => cerrar(d), 120));
    });
    d.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && d.open) {
        cerrar(d);
        summary?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (d.open && !d.contains(e.target as Node)) cerrar(d);
    });
    // Con teclado: al salir el foco del desplegable, se cierra
    d.addEventListener('focusout', (e) => {
      if (d.open && !d.contains(e.relatedTarget as Node | null)) cerrar(d);
    });
  });
</script>

<style>
  /* Barra de lado a lado, fija arriba: crema sólida y una línea fina debajo */
  .cabecera {
    position: fixed;
    inset: var(--aviso-alto) 0 auto;
    z-index: 40;
    background: var(--crema);
    border-bottom: 1px solid var(--linea);
  }

  /* El contenido, con el mismo ancho que el resto de la página (.envoltura) */
  .cabecera__pildora {
    display: flex;
    align-items: center;
    gap: 2rem;
    width: min(100% - 2 * var(--gutter), var(--ancho));
    margin-inline: auto;
    padding: 0.875rem 0;
  }

  .cabecera__logo {
    flex: none;
    display: block;
    height: 26px;
  }

  .cabecera__logo :global(.logo) {
    width: auto;
    height: 100%;
  }

  .cabecera__nav {
    margin-inline: 0.875rem auto;
  }

  /* Selector de idioma: el código actual; al pulsar, los cuatro idiomas */
  .idiomas {
    position: relative;
    flex: none;
  }

  .idiomas summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.5rem;
    padding: 0 0.875rem;
    border-radius: var(--r-pill);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--tinta);
    list-style: none;
    cursor: pointer;
  }

  .idiomas summary::-webkit-details-marker {
    display: none;
  }

  .idiomas summary svg {
    transition: transform 0.25s var(--ease);
  }

  .idiomas[open]:not([data-cerrando]) summary svg {
    transform: rotate(180deg);
  }

  .idiomas__panel {
    right: 0;
  }

  /* Idiomas: rejilla de 2 × 2, nombre y código */
  .idiomas__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
    width: 19rem;
  }

  .cabecera__nav a {
    white-space: nowrap;
  }


  .cabecera__nav ul {
    display: flex;
    align-items: center;
    gap: 1.625rem;
  }

  /* Enlaces y «Espacios» con la misma caja: quedan a la misma altura */
  .cabecera__nav > ul > li > a,
  .submenu summary {
    display: flex;
    align-items: center;
    height: 1.75rem;
    line-height: 1;
  }

  .cabecera__nav a {
    position: relative;
    color: var(--tinta);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  /* Rotulador: al pasar, una pasada de color con los bordes irregulares cruza la mitad
     baja de la palabra desde la izquierda; al salir se recoge por el mismo lado. */
  .cabecera__nav > ul > li > a,
  .submenu summary,
  .idiomas summary {
    --banda-x: 0px;
    --banda-abajo: 0px;
    position: relative;
    isolation: isolate;
  }

  .cabecera__nav > ul > li > a::after,
  .submenu summary::after,
  .idiomas summary::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: calc(var(--banda-x) - 0.45em);
    right: calc(var(--banda-x) - 0.45em);
    bottom: calc(var(--banda-abajo) + 0.3125rem);
    height: 0.9375rem;
    background: var(--banda, var(--n200));
    -webkit-mask: var(--rotulador) center / 100% 100% no-repeat;
    mask: var(--rotulador) center / 100% 100% no-repeat;
    rotate: -1.2deg;
    clip-path: inset(-20% 100% -20% 0);
    transition: clip-path 0.32s cubic-bezier(0.55, 0, 0.75, 0.4);
    pointer-events: none;
  }

  /* Cada pasada un poco torcida a su manera, como a mano */
  .cabecera__nav > ul > li:nth-child(2n) > a::after,
  .cabecera__nav > ul > li:nth-child(2n) .submenu summary::after {
    rotate: 0.9deg;
  }

  .idiomas summary::after {
    rotate: -0.5deg;
  }

  .submenu summary {
    --banda-x: 0.75rem;
    --banda-abajo: 0.25rem;
  }

  .idiomas summary {
    --banda-x: 0.875rem;
    --banda-abajo: 0.375rem;
  }

  @media (hover: hover) {
    .cabecera__nav > ul > li > a:hover::after,
    .submenu summary:hover::after,
    .idiomas summary:hover::after {
      clip-path: inset(-20% -2% -20% 0);
      transition: clip-path 0.5s var(--ease);
    }
  }

  /* Página actual o desplegable abierto: la banda queda puesta */
  .cabecera__nav > ul > li > a[aria-current='page']::after,
  .submenu summary.es-actual::after,
  .submenu[open]:not([data-cerrando]) summary::after,
  .idiomas[open]:not([data-cerrando]) summary::after {
    clip-path: inset(-20% -2% -20% 0);
  }

  /* Espacios: el disparador abre el desplegable */
  .submenu {
    position: relative;
  }

  .cabecera__nav .submenu summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.25rem;
    margin-inline: -0.75rem;
    padding: 0 0.75rem;
    border-radius: var(--r-pill);
    font-size: 0.9375rem;
    color: var(--tinta);
    white-space: nowrap;
    list-style: none;
    cursor: pointer;
  }

  .submenu summary::-webkit-details-marker {
    display: none;
  }

  .submenu summary svg {
    transition: transform 0.25s var(--ease);
  }

  .submenu[open]:not([data-cerrando]) summary svg {
    transform: rotate(180deg);
  }

  .submenu__panel {
    left: -1.5rem;
  }

  /* Destacado a la izquierda (reformer) y los otros dos espacios a la derecha.
     Huecos iguales al relleno del panel y todo estirado: el mismo margen por todos lados
     (sin el align-items: center que hereda de la lista de enlaces del nav). */
  .cabecera__nav .submenu__lista {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    grid-auto-flow: dense;
    align-items: stretch;
    gap: 0.625rem;
    width: 30rem;
  }

  .submenu__destacado {
    grid-row: span 2;
  }

  /* ── Panel de los desplegables ── */
  .desplegable {
    position: absolute;
    top: calc(100% + 0.75rem);
    z-index: 1;
    padding: 0.625rem;
    border-radius: var(--r);
    background: var(--crema);
    box-shadow:
      0 0 0 1px var(--linea),
      0 2px 2px rgb(var(--tinta-rgb) / 0.04),
      0 8px 16px -4px rgb(var(--tinta-rgb) / 0.06),
      var(--sombra);
    transform-origin: top center;
    animation: desplegable-entra 0.2s var(--ease);
  }

  /* Puente invisible: el ratón cruza el hueco sin que se cierre */
  .desplegable::before {
    content: '';
    position: absolute;
    inset: -0.875rem 0 100%;
  }

  [data-cerrando] > .desplegable {
    animation: desplegable-sale 0.18s ease forwards;
  }

  @keyframes desplegable-entra {
    from {
      opacity: 0;
      scale: 0.97;
      translate: 0 -4px;
    }
  }

  @keyframes desplegable-sale {
    to {
      opacity: 0;
      scale: 0.97;
      translate: 0 -4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .desplegable,
    [data-cerrando] > .desplegable {
      animation: none;
    }
  }

  /* Opción: nombre y una línea de texto debajo */
  .cabecera .opcion {
    display: grid;
    gap: 0.3125rem;
    height: 100%;
    padding: 0.75rem 0.875rem;
    border: 0;
    border-radius: var(--r);
    color: var(--tinta);
    text-decoration: none;
    white-space: normal;
    transition: background-color 0.2s var(--ease);
  }

  .cabecera .opcion:hover,
  .cabecera .opcion[aria-current='page'] {
    background: var(--n50);
  }

  .opcion__titulo {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .opcion__texto {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--tinta-60);
  }

  /* Destacado (Reformer): papel cálido con su grano y el arco del sol recortado, como los
     dibujos de la web. Al pasar, el sol sube un poco y el papel se calienta. */
  .cabecera .destacado {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.375rem;
    height: 100%;
    min-height: 10rem;
    padding: 1.125rem;
    border: 0;
    border-radius: var(--r);
    background: color-mix(in srgb, var(--sol-300) 50%, var(--sol-100));
    color: var(--tinta);
    text-decoration: none;
    white-space: normal;
    overflow: hidden;
    transition: background-color 0.3s var(--ease);
  }

  .cabecera .destacado::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image: var(--grano-papel);
    mix-blend-mode: multiply;
    opacity: 0.18;
    pointer-events: none;
  }

  .cabecera .destacado:hover,
  .cabecera .destacado:focus-visible {
    background: color-mix(in srgb, var(--sol-300) 72%, var(--sol-100));
  }

  .destacado__arco {
    display: block;
    margin-bottom: auto;
    overflow: visible;
  }

  .destacado__arco-marco {
    fill: var(--n700);
  }

  .destacado__arco-luz {
    fill: color-mix(in srgb, var(--sol-100) 70%, var(--crema));
  }

  .destacado__arco-sol {
    fill: var(--sol-500);
    transition: translate 0.45s var(--ease);
  }

  .destacado:hover .destacado__arco-sol,
  .destacado:focus-visible .destacado__arco-sol {
    translate: 0 -3px;
  }

  .destacado .opcion__titulo {
    font-size: 1.125rem;
  }

  .destacado .opcion__texto {
    color: rgb(var(--tinta-rgb) / 0.75);
  }

  /* Luz roja y sauna: sin fondo al pasar; el nombre recibe la misma pasada de rotulador
     que los enlaces del header (y la deja puesta en la página actual) */
  .cabecera .submenu__panel .opcion:hover,
  .cabecera .submenu__panel .opcion[aria-current='page'] {
    background: none;
  }

  .submenu__panel .opcion .opcion__titulo {
    position: relative;
    isolation: isolate;
    justify-self: start;
  }

  .submenu__panel .opcion .opcion__titulo::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: -0.35em;
    right: -0.35em;
    bottom: 0.0625rem;
    height: 0.8125rem;
    background: var(--banda, var(--n200));
    -webkit-mask: var(--rotulador) center / 100% 100% no-repeat;
    mask: var(--rotulador) center / 100% 100% no-repeat;
    rotate: -1.2deg;
    clip-path: inset(-20% 100% -20% 0);
    transition: clip-path 0.32s cubic-bezier(0.55, 0, 0.75, 0.4);
    pointer-events: none;
  }

  .submenu__panel li:nth-child(odd) .opcion .opcion__titulo::after {
    rotate: 0.9deg;
  }

  .submenu__panel .opcion:hover .opcion__titulo::after,
  .submenu__panel .opcion:focus-visible .opcion__titulo::after,
  .submenu__panel .opcion[aria-current='page'] .opcion__titulo::after {
    clip-path: inset(-20% -2% -20% 0);
    transition: clip-path 0.5s var(--ease);
  }

  @media (max-width: 75rem) {
    .cabecera__pildora {
      gap: 1rem;
    }
    .cabecera__nav {
      margin-left: 0.25rem;
    }
    .cabecera__nav ul {
      gap: 1.125rem;
    }
  }

  /* Tableta: los enlaces pasan al menú; quedan idioma, botón y menú */
  @media (max-width: 68rem) {
    .cabecera__nav {
      display: none;
    }
    .idiomas {
      margin-left: auto;
    }
  }

  @media (max-width: 56.25rem) {
    .cabecera__pildora {
      padding: 0.625rem 0;
      justify-content: space-between;
    }
    .cabecera__nav,
    .idiomas,
    .cabecera :global(.cabecera__cta) {
      display: none;
    }
    .cabecera__logo {
      height: 22px;
    }
  }
</style>
