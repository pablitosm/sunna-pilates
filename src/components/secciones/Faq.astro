---
import ContactoDudas from '../ContactoDudas.astro';
import type { Ajustes, Home } from '../../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { ajustes, home } = Astro.props;
const { faq } = home;
// Con el horario ampliado, las preguntas que lo tienen usan su respuesta alternativa.
// Las preguntas sin respuesta (pendientes) no se muestran.
const ampliado = ajustes.horario === 'ampliado';
const grupos = faq.grupos
  .map((g) => ({
    ...g,
    preguntas: g.preguntas
      .map((p) => ({ ...p, respuesta: (ampliado && p.respuestaAmpliado) || p.respuesta }))
      .filter((p) => p.respuesta.trim()),
  }))
  .filter((g) => g.preguntas.length);
---

<section id="preguntas" class="faq seccion" aria-labelledby="faq-titulo" data-faq>
  <div class="envoltura faq__rejilla">
    <div class="faq__cabeza">
      <h2 id="faq-titulo" class="t-h2 faq__titulo">{faq.titulo}</h2>
      {faq.contacto && <ContactoDudas ajustes={ajustes} titulo={faq.contacto.titulo} texto={faq.contacto.texto} class="faq__contacto" />}
    </div>

    <div class="faq__cuerpo">
      <!-- Un grupo a la vez: pestañas (con JavaScript; sin él se ven todos) -->
      <div class="faq__pestanas" role="tablist" aria-labelledby="faq-titulo" hidden data-faq-pestanas>
        {
          grupos.map((g, gi) => (
            <button
              type="button"
              class="pestana"
              role="tab"
              id={`faq-pestana-${gi}`}
              aria-controls={`faq-grupo-${gi}`}
              aria-selected={gi === 0 ? 'true' : 'false'}
              tabindex={gi === 0 ? 0 : -1}
            >
              {g.titulo}
            </button>
          ))
        }
      </div>

      <div class="faq__tarjeta">
        {
          grupos.map((g, gi) => (
            <div class="grupo" id={`faq-grupo-${gi}`} role="tabpanel" aria-labelledby={`faq-pestana-${gi}`} data-faq-grupo>
              <h3 class="etiqueta grupo__titulo">{g.titulo}</h3>
              {g.preguntas.map((p) => (
                <details class="pregunta" name="faq">
                  <summary>
                    <span>{p.pregunta}</span>
                    <span class="pregunta__mas" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                        <path d="M7 1.5v11M1.5 7h11" />
                      </svg>
                    </span>
                  </summary>
                  <p class="pregunta__respuesta">{p.respuesta}</p>
                </details>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Pestañas del FAQ: un grupo a la vez. Flechas izquierda/derecha para moverse.
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((faq) => {
    const lista = faq.querySelector<HTMLElement>('[data-faq-pestanas]');
    const pestanas = [...faq.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const grupos = [...faq.querySelectorAll<HTMLElement>('[data-faq-grupo]')];
    if (!lista || pestanas.length < 2) return;
    lista.hidden = false;
    faq.classList.add('faq--pestanas');

    const elegir = (i: number, foco = false) => {
      pestanas.forEach((p, j) => {
        p.setAttribute('aria-selected', String(i === j));
        p.tabIndex = i === j ? 0 : -1;
      });
      grupos.forEach((g, j) => (g.hidden = i !== j));
      if (foco) pestanas[i].focus();
    };

    pestanas.forEach((p, i) => {
      p.addEventListener('click', () => elegir(i));
      p.addEventListener('keydown', (e) => {
        const n = pestanas.length;
        if (e.key === 'ArrowRight') elegir((i + 1) % n, true);
        else if (e.key === 'ArrowLeft') elegir((i - 1 + n) % n, true);
        else return;
        e.preventDefault();
      });
    });
    elegir(0);
  });
</script>

<style>
  .faq {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }


  .faq__rejilla {
    display: flex;
    gap: clamp(2rem, 1rem + 5vw, 5rem);
    align-items: flex-start;
  }

  .faq__cabeza {
    flex: 0 0 min(22rem, 28%);
  }

  .faq__cuerpo {
    flex: 1;
    min-width: 0;
  }

  /* Pestañas: una píldora por grupo */
  .faq__pestanas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }

  .faq__pestanas[hidden] {
    display: none;
  }

  .pestana {
    padding: 0.625rem 1.125rem;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--crema);
    box-shadow: inset 0 0 0 1px var(--n200);
    color: var(--tinta);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .pestana:hover {
    background: var(--n50);
  }

  .pestana[aria-selected='true'] {
    background: var(--n500);
    box-shadow: none;
  }

  .pestana:focus-visible {
    outline: 3px solid var(--n500);
    outline-offset: 3px;
  }

  .faq__tarjeta {
    display: grid;
    border-top: 1px solid var(--linea-fuerte);
    border-bottom: 1px solid var(--linea-fuerte);
  }

  /* Con pestañas, el nombre del grupo ya está arriba */
  .faq--pestanas .grupo__titulo {
    display: none;
  }

  .grupo__titulo {
    padding: 1.125rem 0 0.25rem;
  }

  .faq__cabeza :global(.faq__contacto) {
    max-width: 22rem;
    margin-top: 1.75rem;
  }

  .pregunta + .pregunta {
    border-top: 1px solid var(--linea);
  }

  .pregunta summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1rem 0;
    font-size: 1.0625rem;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }

  .pregunta summary::-webkit-details-marker {
    display: none;
  }

  .pregunta summary:focus-visible {
    border-radius: 16px;
    outline-offset: -3px;
  }

  .pregunta__mas {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--n50);
    color: var(--n900);
    transition: rotate 0.28s var(--ease);
  }

  .pregunta[open] .pregunta__mas {
    rotate: 45deg;
  }

  .pregunta__respuesta {
    max-width: 62ch;
    padding: 0 2.75rem 1.125rem 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--tinta-60);
  }

  /* La fila abierta empuja a las de abajo, 280 ms */
  .pregunta::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.28s var(--ease),
      content-visibility 0.28s allow-discrete;
  }

  .pregunta[open]::details-content {
    block-size: auto;
  }

  @media (max-width: 56.25rem) {
    .faq__rejilla {
      flex-direction: column;
    }
    .faq__rejilla {
      gap: var(--titulo-contenido);
    }
    .faq__cabeza {
      flex: none;
      width: 100%;
    }
    .faq__cabeza :global(.faq__contacto) {
      max-width: none;
    }
    .faq__cuerpo {
      width: 100%;
    }
    /* Móvil: las pestañas se deslizan en una fila */
    .faq__pestanas {
      flex-wrap: nowrap;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .faq__pestanas::-webkit-scrollbar {
      display: none;
    }
    .pestana {
      flex: none;
    }
    .pregunta__respuesta {
      padding-right: 0;
    }
  }
</style>
