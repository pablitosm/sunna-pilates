---
import ContactoDudas from '../ContactoDudas.astro';
import DibujoRazon from '../DibujoRazon.astro';
import { acentuar } from '../../lib/acento';
import { ctaEsFundador, idiomaDe, type Ajustes, type Home } from '../../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
  /** Como página propia: título h1 y más aire arriba. */
  pagina?: boolean;
}
const { ajustes, home, pagina = false } = Astro.props;
const Titulo = pagina ? 'h1' : 'h2';
// El nombre de cada plan, un nivel por debajo del título de la sección
const Nombre = pagina ? 'h2' : 'h3';
const { precios } = home;
// «55 €» en castellano, alemán y francés; «€55» en inglés
const euros = (n: number) =>
  new Intl.NumberFormat(idiomaDe(Astro.currentLocale), { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
const g = precios.graficos;
const intro = (ctaEsFundador(ajustes) && precios.introFundador) || precios.intro;
// Basic al alba, Standard por la mañana, Pro por la tarde y Premium a mediodía
const momentos = ['alba', 'manana', 'tarde', 'mediodia'] as const;
---

<section id="precios" class:list={['precios', { 'precios--pagina': pagina }]} aria-labelledby="precios-titulo">
  <div class="envoltura precios__cabeza">
    <div class="cabeza-seccion">
      <div>
        <Titulo id="precios-titulo" class="t-h2 precios__titulo" set:html={acentuar(precios.titulo)} />
        {intro && <p class="t-lead precios__intro">{intro}</p>}
      </div>
      {precios.subtitulo && <span class="etiqueta">{precios.subtitulo}</span>}
    </div>
  </div>

  <div class="envoltura precios__tarjetas">
    <ul role="list" class="membresias">
      {
        precios.membresias.map((m, i) => (
          <li class:list={['membresia', 'grano', `membresia--${momentos[i % momentos.length]}`, { 'membresia--destacada': m.destacada }]}>
            <!-- Cada plan, un momento del día con su papel y su paisaje -->
            <div class="membresia__escena">
              <DibujoRazon tipo={momentos[i % momentos.length]} />
            </div>
            {m.etiqueta && <span class="membresia__etiqueta">{m.etiqueta}</span>}
            <Nombre class="etiqueta membresia__nombre">{m.nombre}</Nombre>
            <p class="membresia__precio">
              <span class="membresia__cifra">
                {euros(m.precio)}
              </span>
              <span class="membresia__mes">{home.ui.porMes}</span>
            </p>
            <p class="membresia__sesion">
              <strong>{m.precioSesion}</strong> {precios.porSesion}
            </p>
            <div class="grafico">
              <p class="grafico__sesiones">
                {m.pilates}
                {m.pilatesSemana && <span class="grafico__semana">{m.pilatesSemana}</span>}
              </p>
            </div>

            {g && m.luzRoja !== undefined && m.sauna !== undefined ? (
              <div class="grafico">
                <p class="solo-lectores">{m.recovery}</p>
                <dl class="recovery" aria-hidden="true">
                  {[
                    { nombre: g.luzRoja, n: m.luzRoja },
                    { nombre: g.sauna, n: m.sauna },
                  ].map((r) => (
                    <div class:list={['recovery__fila', { 'recovery__fila--no': r.n === 0 }]}>
                      <dt>{r.nombre}</dt>
                      <dd>{r.n === 0 ? g.noIncluida : r.n < 0 ? g.ilimitado : g.porSemana ? `${r.n} ${g.porSemana}` : r.n}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ) : (
              <p class="grafico__pie">{m.recovery}</p>
            )}

            {m.extra && <p class="membresia__extra">{m.extra}</p>}
          </li>
        ))
      }
    </ul>
    {
      ajustes.reservas.membresiasUrl && (
        <p class="precios__enlace">
          <a class="enlace-flecha" href={ajustes.reservas.membresiasUrl} target="_blank" rel="noopener">
            {home.enlaces.membresias} →
          </a>
        </p>
      )
    }
    {
      precios.contacto && (
        <ContactoDudas ajustes={ajustes} titulo={precios.contacto.titulo} texto={precios.contacto.texto} forma="en-linea" class="precios__contacto" />
      )
    }
  </div>
</section>

<style>
  .precios {
    padding-block: var(--seccion);
  }

  /* Página de precios: más aire arriba (cabecera fija) */
  .precios--pagina {
    display: flex;
    flex-direction: column;
    padding-top: var(--pagina-arriba);
    padding-bottom: 0;
  }

  .precios--pagina .precios__titulo {
    font-size: clamp(2.75rem, 1.8rem + 3.5vw, 4.5rem);
    line-height: 1.02;
  }

  .precios__intro {
    max-width: 64ch;
    text-wrap: balance;
    margin-top: 1.25rem;
    color: var(--tinta-60);
  }

  /* ── Membresías ── */
  .membresias {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .membresia {
    --borde: 1.875rem;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    padding: 0 var(--borde) 2rem;
    border-radius: var(--r);
    background: var(--papel);
    color: var(--tinta-t);
    overflow: hidden;
  }

  /* Cada plan con su papel y su tinta: alba, salvia, terracota y cacao */
  .membresia--alba {
    --papel: color-mix(in srgb, var(--sol-100) 55%, var(--crema));
    --tinta-t: var(--tinta);
    --suave-t: var(--tinta-60);
    --linea-t: var(--linea);
  }

  .membresia--manana {
    --papel: color-mix(in srgb, var(--oliva) 28%, var(--crema));
    --tinta-t: var(--oliva-tinta);
    --suave-t: color-mix(in srgb, var(--oliva-tinta) 72%, var(--crema));
    --linea-t: color-mix(in srgb, var(--oliva-tinta) 15%, transparent);
  }

  .membresia--tarde {
    --papel: color-mix(in srgb, var(--sol-300) 55%, var(--sol-100));
    --tinta-t: var(--tinta);
    --suave-t: var(--n900);
    --linea-t: rgb(var(--tinta-rgb) / 0.16);
  }

  .membresia--mediodia {
    --papel: var(--cacao);
    --tinta-t: var(--crema);
    --suave-t: color-mix(in srgb, var(--crema) 78%, var(--sol-200));
    --linea-t: rgb(var(--crema-rgb) / 0.18);
  }


  /* El grano va encima del contenido; en el papel oscuro aclara en vez de oscurecer */
  .membresia {
    --grano-capa: 1;
    --grano-opacidad: 0.18;
  }

  .membresia--mediodia {
    --grano-mezcla: screen;
    --grano-opacidad: 0.08;
  }

  /* La escena del sol, a sangre arriba de la tarjeta */
  .membresia__escena {
    margin: 0 calc(-1 * var(--borde)) 0.5rem;
    aspect-ratio: 12 / 7;
    max-width: none;
  }

  .membresia__etiqueta {
    position: absolute;
    z-index: 2;
    left: var(--borde);
    top: 1rem;
    padding: 0.375rem 0.875rem;
    border-radius: var(--r-pill);
    background: var(--n500);
    color: var(--tinta);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .membresia__nombre {
    margin-bottom: -0.25rem;
    color: var(--suave-t);
  }

  .membresia__precio {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .membresia__cifra {
    font-size: clamp(2.5rem, 1.9rem + 1.8vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .membresia__mes {
    color: var(--suave-t);
  }

  /* Precio por sesión: dato secundario bajo el precio mensual, visible sin competir con él */
  .membresia__sesion {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    margin-top: -0.375rem;
    font-size: 0.9375rem;
    color: var(--suave-t);
  }

  .membresia__sesion strong {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--tinta-t);
  }

  /* Gráficos de cada tarjeta: la semana y el recovery del mes */
  .grafico {
    display: grid;
    gap: 0.625rem;
    padding-top: 1.125rem;
    border-top: 1px solid var(--linea-t);
  }

  .grafico__pie {
    font-size: 0.875rem;
    color: var(--suave-t);
  }

  /* Sesiones de reformer: el dato principal de cada plan */
  .grafico__sesiones {
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .grafico__semana {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    color: var(--suave-t);
  }

  /* Luz roja y sauna: nombre y cantidad en dos columnas; las cantidades
     arrancan todas en la misma línea vertical */
  .recovery {
    display: grid;
    gap: 0.5rem;
  }

  .recovery__fila {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
    font-size: 0.9375rem;
  }

  .recovery__fila dd {
    color: var(--tinta-t);
  }

  .recovery__fila--no dt,
  .recovery__fila--no dd {
    color: var(--suave-t);
  }

  .membresia__extra {
    margin-top: auto;
    padding: 0.625rem 0.875rem;
    border-radius: var(--r);
    background: var(--sol-500);
    color: var(--cacao);
    font-size: 0.875rem;
    text-align: center;
  }

  /* ¿Dudas con los planes? Bajo las tarjetas */
  .precios__tarjetas :global(.precios__contacto) {
    margin-top: var(--titulo-contenido);
  }

  @media (max-width: 64rem) {
    .membresias {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.75rem;
    }
  }

  @media (max-width: 36rem) {
    .membresias {
      grid-template-columns: 1fr;
    }
  }
</style>
