---
/* Una página legal (aviso legal, privacidad, cookies, condiciones) en un idioma. */
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getSite, type Lang, type PaginaLegal } from '../lib/content';

interface Props {
  lang: Lang;
  legal: PaginaLegal;
}
const { lang, legal } = Astro.props;
const pagina = await getEntry('legal', `${lang}/legal/${legal}`);
if (!pagina) throw new Error(`Falta src/content/${lang}/legal/${legal}.md`);
const { Content } = await render(pagina);
const { home } = await getSite(lang);
---

<Base lang={lang} titulo={pagina.data.titulo} descripcion={pagina.data.descripcion} indexar={false} legal={legal}>
  <article class="legal envoltura">
    <h1 class="t-h2">{pagina.data.titulo}</h1>
    {pagina.data.actualizado && <p class="t-small t-secundario">{home.ui.actualizado}: {pagina.data.actualizado}</p>}
    <div class="legal__cuerpo">
      <Content />
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-block: var(--pagina-arriba) var(--seccion);
    max-width: 46rem;
  }

  .legal__cuerpo {
    margin-top: 2.5rem;
  }

  .legal__cuerpo :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: var(--t-h3);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .legal__cuerpo :global(p),
  .legal__cuerpo :global(ul) {
    margin-bottom: 1rem;
    color: var(--tinta-60);
  }

  .legal__cuerpo :global(strong) {
    color: var(--tinta);
    font-weight: 500;
  }

  .legal__cuerpo :global(blockquote) {
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    border-radius: var(--r);
    background: var(--n50);
  }

  .legal__cuerpo :global(blockquote p) {
    margin: 0;
    color: var(--tinta);
  }

  .legal__cuerpo :global(table) {
    width: 100%;
    margin-bottom: 1.5rem;
    border-collapse: collapse;
    font-size: var(--t-small);
  }

  .legal__cuerpo :global(th),
  .legal__cuerpo :global(td) {
    padding: 0.6rem 0.5rem;
    border-bottom: 1px solid var(--linea);
    text-align: left;
    vertical-align: top;
  }

  .legal__cuerpo :global(th) {
    font-weight: 500;
  }
</style>
