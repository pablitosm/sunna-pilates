---
import '../styles/global.css';
import BarraFundadores from '../components/BarraFundadores.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import BookingPanel from '../components/vue/BookingPanel.vue';
import CookieConsent from '../components/vue/CookieConsent.vue';
import { sinAcento } from '../lib/acento';
// Las dos letras de los títulos, precargadas: llegan antes de pintar y el texto no salta al cambiar de letra
import fuenteTexto from '@fontsource-variable/dm-sans/files/dm-sans-latin-opsz-normal.woff2?url';
import fuenteAcento from '@fontsource/ephesis/files/ephesis-latin-400-normal.woff2?url';
import { colorTema, getSite, idiomas, localeOg, mapsUrl, urlPagina, whatsappUrl, type Lang, type Pagina } from '../lib/content';

interface Props {
  titulo?: string;
  descripcion?: string;
  lang?: Lang;
  indexar?: boolean;
  /** Portada o página propia de un idioma: enlaza sus versiones en los otros idiomas (hreflang). */
  alternos?: boolean;
  /** Página propia (primera sesión, precios, cada espacio); sin ella, la portada. */
  pagina?: Pagina;
  /** Sin la barra fija del móvil (la página ya tiene sus propios botones de reservar). */
  sinBarraMovil?: boolean;
}
const { titulo, descripcion, lang = 'es', indexar = true, alternos = false, pagina, sinBarraMovil = false } = Astro.props;
const { ajustes, home } = await getSite(lang);

// Página para la analítica: igual en los 4 idiomas (inicio, precios, sauna…); legales y 404 son «otra»
const paginaAnalitica = pagina ?? (alternos ? 'inicio' : 'otra');
const title = titulo ? `${sinAcento(titulo)} · SUNNA` : home.seo.titulo;
const description = descripcion ?? home.seo.descripcion;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const wa = whatsappUrl(ajustes.contacto.whatsapp, home.ui.whatsappMensaje);
const hayMedicion = Boolean(ajustes.medicion.googleAnalyticsId || ajustes.medicion.metaPixelId);

// Datos estructurados de negocio local (SEO local).
const negocio = {
  '@context': 'https://schema.org',
  '@type': 'ExerciseGym',
  name: 'SUNNA Pilates',
  description: home.seo.descripcion,
  ...(Astro.site ? { url: Astro.site.href } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: ajustes.direccion.calle,
    postalCode: ajustes.direccion.codigoPostal,
    addressLocality: ajustes.direccion.ciudad,
    addressRegion: ajustes.direccion.provincia,
    addressCountry: ajustes.direccion.pais,
  },
  hasMap: mapsUrl(ajustes),
  ...(ajustes.contacto.telefonoAyuda ? { telephone: ajustes.contacto.telefonoAyuda } : {}),
  ...(ajustes.contacto.email ? { email: ajustes.contacto.email } : {}),
  sameAs: [ajustes.contacto.instagram, ajustes.contacto.googleBusiness].filter(Boolean),
};
---

<!doctype html>
<html lang={lang} data-paleta={ajustes.paleta} data-pagina={paginaAnalitica}>
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteAcento} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <!-- Antes de pintar: los acentos esperan su pasada de rotulador (ver el script del final) -->
    <script is:inline>
      if ('IntersectionObserver' in window) document.documentElement.classList.add('con-acentos');
    </script>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {!indexar && <meta name="robots" content="noindex" />}
    {
      alternos &&
        Astro.site &&
        [...idiomas, 'x-default' as const].map((l) => (
          <link
            rel="alternate"
            hreflang={l}
            href={new URL(urlPagina(l === 'x-default' ? 'es' : l, pagina), Astro.site).href}
          />
        ))
    }
    <meta name="theme-color" content={colorTema[ajustes.paleta]} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeOg[lang]} />
    <meta property="og:site_name" content="SUNNA Pilates" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="geo.region" content="ES-TF" />
    <meta name="geo.placename" content={ajustes.direccion.ciudad} />
    <script type="application/ld+json" set:html={JSON.stringify(negocio).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="saltar" href="#contenido">{home.ui.saltar}</a>
    <BarraFundadores ajustes={ajustes} home={home} />
    <Header ajustes={ajustes} home={home} lang={lang} pagina={pagina} />
    <main id="contenido">
      <slot />
    </main>
    <Footer ajustes={ajustes} home={home} />
    {!sinBarraMovil && <MobileBar ajustes={ajustes} home={home} />}

    {
      ajustes.estado === 'preapertura' && (
    <BookingPanel
      client:idle
      estado={ajustes.estado}
      endpoint={ajustes.formulario.endpoint}
      reservaUrl={ajustes.reservas.primeraSesionUrl}
      whatsapp={wa}
      instagram={ajustes.contacto.instagram}
      privacidadUrl="/privacidad"
      textos={home.panel}
    />
      )
    }

    {
      hayMedicion && (
        <CookieConsent
          client:idle
          gaId={ajustes.medicion.googleAnalyticsId}
          pixelId={ajustes.medicion.metaPixelId}
          cookiesUrl="/cookies"
          textos={home.cookies}
        />
      )
    }
    <script>
      // Acentos de los títulos: la pasada de rotulador cruza la palabra al entrar en pantalla
      const acentos = document.querySelectorAll('.acento');
      if (acentos.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('visto');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px' },
        );
        acentos.forEach((a) => io.observe(a));
      }

      // Dibujos con animación continua: solo se mueven mientras están en pantalla
      const animados = document.querySelectorAll('.recorte--horario');
      if (animados.length && 'IntersectionObserver' in window) {
        const vista = new IntersectionObserver((entradas) => {
          for (const e of entradas) e.target.classList.toggle('en-vista', e.isIntersecting);
        });
        animados.forEach((a) => vista.observe(a));
      }
    </script>
    <script>
      // Analítica propia y sin cookies (panel → Analítica): vistas, clics, apartados vistos, tiempo y
      // recorrido. Va a /api/evento; no guarda nada en el navegador. Solo en la web publicada, y nunca
      // a quien pide no ser seguido (Do Not Track / Global Privacy Control).
      const privado = navigator.doNotTrack === '1' || (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl;
      if (!import.meta.env.DEV && !privado) {
        const html = document.documentElement;
        const vista = Math.random().toString(36).slice(2, 12) + Date.now().toString(36).slice(-4);
        const base = { v: vista, ruta: location.pathname, pagina: html.dataset.pagina ?? '', idioma: html.lang };
        const enviar = (datos: Record<string, unknown>) => {
          const cuerpo = JSON.stringify({ ...base, ...datos });
          if (!navigator.sendBeacon?.('/api/evento', new Blob([cuerpo], { type: 'text/plain' }))) {
            fetch('/api/evento', { method: 'POST', body: cuerpo, keepalive: true }).catch(() => {});
          }
        };

        // La vista y de dónde llega (utm_source o el dominio que la trae). Si viene de otra
        // página de la propia web no es una entrada: no cuenta como fuente.
        const utm = new URLSearchParams(location.search).get('utm_source');
        let fuente = utm ?? '';
        let interna = false;
        if (!fuente && document.referrer) {
          try {
            const desde = new URL(document.referrer).hostname;
            if (desde === location.hostname) interna = true;
            else fuente = desde;
          } catch {}
        }
        enviar({ t: 'vista', fuente, interna });

        // Clics en enlaces y botones: a dónde llevan, qué ponen y en qué parte de la página están
        const externos: [RegExp, string][] = [
          [/(^|\.)wa\.me$|whatsapp/, 'whatsapp'],
          [/instagram\.com$/, 'instagram'],
          [/google\.[a-z.]+$|goo\.gl$|maps\.app/, 'mapa'],
          [/apps\.apple\.com$/, 'app-store'],
          [/play\.google\.com$/, 'google-play'],
          [/bsport/, 'bsport'],
        ];
        const destino = (el: Element) => {
          const propio = (el as HTMLElement).dataset.evento;
          if (propio) return propio;
          if (!(el instanceof HTMLAnchorElement)) return (el.closest('details')?.querySelector('summary') === el && 'desplegable') || 'boton';
          if (el.protocol === 'mailto:') return 'email';
          if (el.protocol === 'tel:') return 'telefono';
          if (el.hostname && el.hostname !== location.hostname) {
            return externos.find(([r]) => r.test(el.hostname))?.[1] ?? el.hostname.replace(/^www\./, '');
          }
          return el.pathname + el.hash;
        };
        document.addEventListener(
          'click',
          (e) => {
            const el = (e.target as Element | null)?.closest('a[href], button, summary');
            if (!el) return;
            const nombre = destino(el);
            // El texto tal y como se ve (innerText separa título y descripción de las opciones del menú)
            const etiqueta = (el.getAttribute('aria-label') || (el as HTMLElement).innerText || '').replace(/\s+/g, ' ').trim().slice(0, 80);
            const zona = el.closest('header') ? 'cabecera' : el.closest('footer') ? 'pie' : el.closest('section[id], aside[id]')?.id ?? '';
            // Botones de reservar: los principales (sol), WhatsApp, las apps y bsport
            const objetivo =
              el.matches('.cta, .boton-sol, [data-objetivo]') || ['whatsapp', 'app-store', 'google-play', 'bsport'].includes(nombre);
            enviar({ t: 'clic', nombre, etiqueta, zona, objetivo });
          },
          { capture: true },
        );

        // Apartados que llegan a verse, una vez por visita: cuando ocupan media pantalla
        // (o el 40 % de su alto si son más bajos; los muy altos nunca llegan a ese porcentaje)
        const vistos = new Set<string>();
        const apartados = new IntersectionObserver(
          (entradas) => {
            for (const en of entradas) {
              const id = en.target.id;
              const basta = Math.min(en.boundingClientRect.height * 0.4, innerHeight * 0.5);
              if (!en.isIntersecting || vistos.has(id) || en.intersectionRect.height < basta) continue;
              vistos.add(id);
              enviar({ t: 'seccion', nombre: id });
              apartados.unobserve(en.target);
            }
          },
          { threshold: [0, 0.1, 0.2, 0.3, 0.4, 0.6, 0.8, 1] },
        );
        document.querySelectorAll('main section[id], main aside[id]').forEach((s) => apartados.observe(s));

        // Al salir o cambiar de pestaña: tiempo con la página visible y hasta dónde ha bajado
        let visible = document.visibilityState === 'visible' ? performance.now() : 0;
        let acumulado = 0;
        let profundidad = 0;
        const medir = () => {
          const alto = document.documentElement.scrollHeight - innerHeight;
          profundidad = Math.max(profundidad, alto > 0 ? Math.round((100 * scrollY) / alto) : 100);
        };
        addEventListener('scroll', medir, { passive: true });
        medir();
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') {
            if (visible) acumulado += performance.now() - visible;
            visible = 0;
            enviar({ t: 'salida', segundos: Math.round(acumulado / 1000), profundidad });
          } else {
            visible = performance.now();
          }
        });
      }
    </script>
  </body>
</html>

<style>
  .saltar {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 60;
    padding: 0.75rem 1.25rem;
    border-radius: var(--r-pill);
    background: var(--tinta);
    color: var(--crema);
    transform: translateY(-200%);
    transition: transform 0.3s var(--ease);
  }

  .saltar:focus {
    transform: translateY(0);
  }
</style>
