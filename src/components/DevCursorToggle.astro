---
/*
 * Interruptor del cursor personalizado. Solo existe en desarrollo (npm run dev):
 * en la web publicada no se genera. Guarda la elección en este navegador.
 */
---

{
  import.meta.env.DEV && (
    <button type="button" class="dev-cursor" data-dev-cursor aria-pressed="false">
      <span class="dev-cursor__punto" aria-hidden="true" />
      Cursor <strong data-dev-cursor-estado>no</strong>
    </button>
  )
}
{
  import.meta.env.DEV && (
    <script is:inline>
  const boton = document.querySelector('[data-dev-cursor]');
  if (boton) {
    const activo = document.documentElement.dataset.cursor === 'on';
    boton.setAttribute('aria-pressed', String(activo));
    const estado = boton.querySelector('[data-dev-cursor-estado]');
    if (estado) estado.textContent = activo ? 'sí' : 'no';
    boton.addEventListener('click', () => {
      try {
        localStorage.setItem('sunna-cursor-dev', activo ? 'off' : 'on');
      } catch {
        /* sin almacenamiento */
      }
      location.reload();
    });
  }
    </script>
  )
}



<style>
  .dev-cursor {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 300;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border: 1px dashed var(--tinta-60);
    border-radius: var(--r-pill);
    background: rgb(253 246 238 / 0.92);
    color: var(--tinta);
    font: 400 0.8125rem var(--font);
    cursor: pointer;
  }

  .dev-cursor strong {
    font-weight: 500;
  }

  .dev-cursor__punto {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--tinta-60);
  }

  .dev-cursor[aria-pressed='true'] .dev-cursor__punto {
    background: var(--n500);
  }

  @media (hover: none) {
    .dev-cursor {
      display: none;
    }
  }
</style>
