---
import { acentuar } from '../../lib/acento';
import CtaButton from '../CtaButton.astro';
import DibujoPortada from '../DibujoPortada.astro';
import { hayPlazasFundador, plazasFundador, type Ajustes, type Home } from '../../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { ajustes, home } = Astro.props;
const { portada } = home;
// Naranja y cacao llevan el dibujo del amanecer; las demás paletas, un fondo liso del color principal
const liso = !['naranja', 'cacao'].includes(ajustes.paleta);
// El subtítulo en dos tiempos: lo que tienes (suave) y la promesa (en tinta)
const [subIntro, ...subResto] = portada.subtitulo.split(/(?<=\.)\s+/);
const subCierre = subResto.join(' ');
const conFecha = ajustes.estado === 'preapertura' && ajustes.fechaApertura;
const lugar = conFecha
  ? `${ajustes.direccion.ciudad} · ${portada.abrimos} ${ajustes.fechaApertura}`
  : ajustes.direccion.ciudad;

// Antes de abrir, la oferta de fundadores asoma ya en la portada y lleva a su bloque
const f = ajustes.fundadores;
const libres = plazasFundador(ajustes);
const plazas =
  ajustes.estado === 'preapertura' && hayPlazasFundador(ajustes)
    ? libres < f.plazasTotales
      ? `${libres} ${home.precios.fundadores.plazas} ${f.plazasTotales}`
      : home.precios.fundadores.etiqueta
    : '';
---

<section id="portada" class:list={['portada', { 'portada--foto': !liso, 'portada--liso': liso }]} aria-labelledby="portada-titulo">
  <!-- El dibujo ocupa el sitio de la foto y se funde igual con el papel crema -->
  {
    !liso && (
      <div class="portada__foto">
        <DibujoPortada />
      </div>
    )
  }

  <div class="envoltura portada__texto">
    {conFecha && <p class="portada__fecha">{lugar}</p>}
    <h1 id="portada-titulo" class="portada__titulo" set:html={acentuar(portada.titular)} />
    <p class="portada__subtitulo">
      <span set:html={acentuar(subIntro)} />
      {subCierre && <span class="portada__subtitulo-cierre" set:html={acentuar(subCierre)} />}
    </p>
    <div class="portada__acciones">
      <CtaButton ajustes={ajustes} home={home} />
    </div>
    {
      plazas && (
        <a class="portada__plazas" href="#fundadores">
          <span class="portada__plazas-punto" aria-hidden="true" />
          {plazas}
        </a>
      )
    }
  </div>
</section>

<style>
  .portada {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: max(100svh, 44rem);
    max-height: 62rem;
    padding: clamp(7rem, 5rem + 4vw, 8.5rem) 0 var(--seccion);
    background: var(--crema);
  }

  /* Escritorio: el dibujo ocupa la derecha hasta el borde y se desvanece hacia el texto */
  .portada__foto {
    position: absolute;
    z-index: -1;
    inset: 0 0 0 38%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.5) 26%, #000 52%);
    mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.5) 26%, #000 52%);
  }

  /* Un poco de crema abajo para que la sección siguiente no corte en seco */
  .portada--foto::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: auto 0 0;
    height: 18%;
    background: linear-gradient(180deg, rgb(var(--crema-rgb) / 0), var(--crema));
    pointer-events: none;
  }

  /* Paletas alternativas: portada lisa en el color principal. Encima, texto en tinta plena
     (los grises no llegan a contraste); la píldora en crema la pone global.css */
  .portada--liso {
    --texto: var(--tinta-rgb);
    background: var(--n500);
  }

  .portada--liso .portada__titulo {
    color: rgb(var(--texto));
  }

  .portada--liso .portada__fecha,
  .portada--liso .portada__subtitulo > :first-child,
  .portada--liso .portada__plazas {
    color: rgb(var(--texto) / 0.82);
  }

  .portada--liso .portada__plazas-punto {
    background: var(--crema);
    box-shadow: 0 0 0 4px rgb(var(--crema-rgb) / 0.35);
  }

  .portada__fecha {
    margin-bottom: 1.25rem;
    font-size: 0.9375rem;
    color: var(--tinta-60);
  }

  .portada__titulo {
    max-width: 10ch;
    margin-bottom: 1.5rem;
    font-size: clamp(3rem, 1.4rem + 6vw, 6rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .portada__subtitulo {
    max-width: 30ch;
    margin-bottom: 2.25rem;
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--tinta-60);
    text-wrap: balance;
  }

  /* La promesa, en su propia línea y en tinta */
  .portada__subtitulo-cierre {
    display: block;
    margin-top: 0.5rem;
    color: var(--tinta);
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .portada__plazas {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.5rem;
    font-size: var(--t-small);
    color: var(--tinta-60);
    text-decoration: none;
  }

  .portada__plazas:hover {
    color: var(--tinta);
  }

  .portada__plazas-punto {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--r-pill);
    background: var(--n500);
    box-shadow: 0 0 0 4px rgb(var(--n500-rgb) / 0.2);
  }

  /* Móvil: la foto arriba, de borde a borde, fundida en crema por abajo; las colinas
     terminan de fundirse justo encima del titular, que no queda cortado por su borde */
  @media (max-width: 56.25rem) {
    .portada {
      display: block;
      min-height: 0;
      max-height: none;
      padding: 0 0 calc(5.5rem + env(safe-area-inset-bottom));
    }

    .portada--foto {
      padding-top: min(46svh, 26rem);
    }

    .portada:not(.portada--foto) {
      padding-top: calc(8rem + var(--aviso-alto));
    }

    .portada__foto {
      inset: 0 0 auto;
      height: min(50svh, 28rem);
      -webkit-mask-image: linear-gradient(180deg, #000 45%, rgb(0 0 0 / 0.5) 72%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 45%, rgb(0 0 0 / 0.5) 72%, transparent 100%);
    }

    .portada--foto::after {
      display: none;
    }

    .portada__titulo {
      font-size: clamp(2.75rem, 1.5rem + 7vw, 4rem);
    }

    /* En móvil el botón está en la barra fija inferior */
    .portada__acciones > :global(.cta) {
      display: none;
    }
  }
</style>
