---
/*
 * Acceso privado. El formulario lo procesa el servicio de acceso del servidor
 * (servidor/acceso.py) a través de Caddy: POST /auth/login.
 */
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Acceso · SUNNA</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fdf6ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="acceso">
    <div class="acceso__halo" aria-hidden="true"></div>
    <div class="acceso__portal" aria-hidden="true"><span class="acceso__sol"></span></div>

    <main class="acceso__marco">
      <form class="tarjeta" method="post" action="/auth/login" data-login>
        <div class="tarjeta__logo">
          <Logo label="SUNNA" />
        </div>
        <p class="etiqueta">Santa Cruz de Tenerife</p>
        <h1 class="tarjeta__titulo">Acceso privado</h1>

        <p class="tarjeta__error" role="alert" data-error hidden></p>

        <label class="campo">
          <span class="campo__icono" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="8.5" r="3.75"></circle><path d="M4.75 20c.75-3.75 3.6-5.75 7.25-5.75S18.5 16.25 19.25 20"></path></svg>
          </span>
          <span class="campo__cuerpo">
            <span class="campo__etiqueta">Usuario</span>
            <input name="usuario" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus />
          </span>
        </label>

        <label class="campo">
          <span class="campo__icono" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5.25" y="10.75" width="13.5" height="9.5" rx="2.25"></rect><path d="M8.25 10.75V8a3.75 3.75 0 0 1 7.5 0v2.75"></path></svg>
          </span>
          <span class="campo__cuerpo">
            <span class="campo__etiqueta">Contraseña</span>
            <input name="password" type="password" autocomplete="current-password" required />
          </span>
        </label>

        <input type="hidden" name="next" value="/" data-next />

        <button class="enviar" type="submit">
          <span>Entrar</span>
          <span class="enviar__circulo" aria-hidden="true"><Icon name="flecha" size={22} /></span>
        </button>
      </form>
    </main>

    <script>
      const q = new URLSearchParams(location.search);
      const next = q.get('next');
      const campoNext = document.querySelector<HTMLInputElement>('[data-next]');
      if (campoNext && next && next.startsWith('/') && !next.startsWith('//')) campoNext.value = next;
      const error = q.get('error');
      const aviso = document.querySelector<HTMLElement>('[data-error]');
      if (aviso && error) {
        aviso.textContent =
          error === 'espera'
            ? 'Demasiados intentos. Vuelve a probar dentro de unos minutos.'
            : 'Usuario o contraseña incorrectos.';
        aviso.hidden = false;
        document.querySelector<HTMLInputElement>('input[name="password"]')?.focus();
      }
      document.querySelector('[data-login]')?.addEventListener('submit', (e) => {
        const b = (e.currentTarget as HTMLFormElement).querySelector('button');
        if (b) b.setAttribute('aria-busy', 'true');
      });
    </script>
  </body>
</html>

<style>
  .acceso {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: hidden;
    background: linear-gradient(180deg, var(--crema), var(--tostado));
  }

  .acceso__halo {
    position: absolute;
    z-index: -2;
    left: 50%;
    top: 12%;
    width: min(77.5rem, 160vw);
    height: 56.25rem;
    translate: -50% 0;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      rgb(255 130 53 / 0.5) 0%,
      rgb(255 167 107 / 0.32) 34%,
      rgb(255 196 154 / 0.16) 58%,
      rgb(253 246 238 / 0) 100%
    );
  }

  /* El portal con el sol, como en la portada */
  .acceso__portal {
    position: absolute;
    z-index: -1;
    right: 8vw;
    bottom: 0;
    width: clamp(20rem, 30vw, 30rem);
    height: min(82%, 44rem);
    border-radius: 999px 999px 0 0;
    background: linear-gradient(180deg, var(--n50) 0%, var(--n100) 55%, var(--n200) 100%);
    overflow: hidden;
  }

  .acceso__sol {
    position: absolute;
    left: 50%;
    top: 16%;
    width: 62%;
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 999px;
    background: radial-gradient(
      closest-side,
      rgb(255 241 230 / 0.95) 0%,
      var(--n200) 40%,
      var(--n300) 64%,
      var(--n500) 86%,
      var(--n500) 100%
    );
  }

  @media (max-width: 56.25rem) {
    .acceso__portal {
      display: none;
    }
  }

  .acceso__marco {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 1.5rem 0.75rem;
  }

  .tarjeta {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 28rem);
    padding: clamp(1.75rem, 1rem + 3vw, 2.75rem);
    border-radius: var(--r-l);
    background: var(--crema);
    border: 1px solid var(--n100);
    box-shadow: 0 24px 48px -28px rgb(140 58 18 / 0.4);
  }

  .tarjeta__logo {
    width: 8.5rem;
    margin-bottom: 1.5rem;
  }

  .tarjeta__titulo {
    margin-bottom: 1rem;
    font-size: clamp(2.25rem, 1.8rem + 2vw, 2.75rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
  }

  .tarjeta__error {
    padding: 0.75rem 1rem;
    border-radius: var(--r-s);
    background: var(--n50);
    border: 1px solid var(--n200);
    font-size: 0.9375rem;
    color: var(--n900);
  }

  .campo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 1.25rem 0.4rem 0.45rem;
    border-radius: var(--r-pill);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--n100);
    cursor: text;
    transition: box-shadow 0.25s var(--ease);
  }

  .campo:focus-within {
    box-shadow:
      inset 0 0 0 1px var(--n300),
      0 0 0 3px var(--n500);
  }

  .campo__icono {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--n50);
    color: var(--n900);
  }

  .campo__cuerpo {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .campo__etiqueta {
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--tinta-60);
  }

  .campo input {
    width: 100%;
    padding: 0.1rem 0 0.2rem;
    border: 0;
    background: transparent;
    font-size: 1rem;
    outline: none;
  }

  /* Botón firma: la píldora fundida */
  .enviar {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 3.5rem;
    margin-top: 0.75rem;
    padding: 0 0.3rem 0 1.5rem;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--n500);
    color: var(--tinta);
    font: 400 1.0625rem var(--font);
    cursor: pointer;
    box-shadow: var(--sombra-boton);
    transition: background-color 0.22s var(--ease);
  }

  .enviar[aria-busy='true'] {
    background: var(--n200);
    cursor: progress;
  }

  .enviar__circulo {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--n500);
    box-shadow: inset 0 0 0 1px rgb(59 29 14 / 0.1);
    transition: transform 0.6s var(--ease);
  }

  .enviar:hover .enviar__circulo {
    transform: translateX(6px);
    transition-duration: 0.22s;
  }

  .enviar:focus-visible {
    outline-offset: 4px;
    border-radius: var(--r-pill);
  }
</style>
