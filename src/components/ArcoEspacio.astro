---
/*
 * El dibujo de cada espacio (reformer, sauna, luz roja), en recortes de papel como el
 * resto de la web: formas planas sin contorno, colores de la paleta y el grano del papel.
 * Con foto real, la foto. Lo usan la página de cada espacio y los accesos de «Descubre
 * SUNNA», siempre en 4:3. El tamaño y el radio los pone quien lo usa (clase).
 */
import PhotoSlot from './PhotoSlot.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  tipo: 'reformer' | 'sauna' | 'luz-roja';
  foto?: { imagen: ImageMetadata; alt: string };
  sizes?: string;
  class?: string;
}
const { tipo, foto, sizes = '(min-width: 56rem) 40vw, 100vw', class: className } = Astro.props;

// Rejilla de leds de los dos paneles de luz roja (3 × 8 por panel), repartida en cada panel
const panel = { y: 76, ancho: 32, alto: 70 };
const columnas = 3;
const filas = 8;
const puntos = [122, 166].flatMap((x0) =>
  Array.from({ length: columnas * filas }, (_, i) => ({
    x: x0 + (panel.ancho / (columnas + 1)) * ((i % columnas) + 1),
    y: panel.y + (panel.alto / (filas + 1)) * (Math.floor(i / columnas) + 1),
  })),
);
// Tablas verticales de la sauna, a dos tonos
const tablas = Array.from({ length: 10 }, (_, i) => i * 32);
---

{
  foto ? (
    <PhotoSlot foto={foto} class={className} sizes={sizes} />
  ) : (
    <div class:list={['arco', 'grano', `arco--${tipo}`, className]} aria-hidden="true">
      {tipo === 'reformer' && (
        <svg class="escena" viewBox="0 0 320 240" preserveAspectRatio="xMidYMid slice">
          <rect class="ref-pared" width="320" height="240" />
          {/* Un sol grande detrás de la máquina */}
          <circle class="e-halo" cx="168" cy="104" r="76" />
          <circle class="e-sol" cx="168" cy="104" r="52" />
          <rect class="ref-suelo" y="196" width="320" height="44" />
          <rect class="ref-zocalo" y="196" width="320" height="4" />
          {/* El reformer de perfil: base de madera, carro de piel, barra de pies, muelles,
              hombrera y reposacabezas, y al otro lado el poste con su polea y su cuerda */}
          <g transform="translate(30 210)">
            <rect class="ref-madera-osc" x="12" y="-14" width="10" height="14" />
            <rect class="ref-madera-osc" x="236" y="-14" width="10" height="14" />
            <rect class="ref-madera" x="0" y="-32" width="260" height="20" rx="4" />
            <rect class="ref-madera-osc" x="0" y="-16" width="260" height="5" />
            <path class="ref-muelles" d="M60 -38c3-4 6 4 9 0s6 4 9 0 6 4 9 0 6 4 9 0" />
            <path class="ref-barra" d="M40 -32 L28 -84" />
            <rect class="ref-piel" x="16" y="-92" width="26" height="12" rx="6" />
            <rect class="ref-piel" x="98" y="-46" width="112" height="14" rx="4" />
            <rect class="ref-piel-osc" x="98" y="-34" width="112" height="3" />
            <rect class="ref-piel-osc" x="186" y="-54" width="28" height="9" rx="4" />
            <rect class="ref-piel-osc" x="166" y="-64" width="9" height="20" rx="3" />
            <rect class="ref-metal" x="243" y="-74" width="8" height="44" rx="2" />
            <circle class="r-polea" cx="247" cy="-76" r="6" />
            <path class="ref-cuerda" d="M247 -76 Q226 -66 206 -48" />
          </g>
        </svg>
      )}
      {tipo === 'sauna' && (
        <svg class="escena" viewBox="0 0 320 240" preserveAspectRatio="xMidYMid slice">
          {/* Tablas de madera a dos tonos */}
          {tablas.map((x, i) => (
            <rect class:list={[i % 2 ? 'sau-tabla' : 'sau-tabla-clara']} x={x} width="32" height="240" />
          ))}
          {/* El calor del infrarrojo, como un sol detrás de los bancos */}
          <circle class="sau-aura" cx="160" cy="96" r="78" />
          <circle class="e-halo" cx="160" cy="96" r="50" />
          <circle class="e-sol" cx="160" cy="96" r="34" />
          {/* Banco alto y banco bajo */}
          <rect class="sau-banco" x="24" y="122" width="272" height="16" rx="3" />
          <rect class="sau-pata" x="44" y="138" width="12" height="40" />
          <rect class="sau-pata" x="264" y="138" width="12" height="40" />
          <rect class="sau-banco" x="0" y="176" width="320" height="16" rx="3" />
          <rect class="sau-suelo" y="192" width="320" height="48" />
          {/* Una toalla doblada */}
          <rect class="sau-toalla" x="208" y="108" width="44" height="14" rx="4" />
          <rect class="sau-toalla-raya" x="208" y="113" width="44" height="3" />
        </svg>
      )}
      {tipo === 'luz-roja' && (
        <svg class="escena" viewBox="0 0 320 240" preserveAspectRatio="xMidYMid slice">
          <rect class="ref-pared" width="320" height="240" />
          <rect class="ref-suelo" y="196" width="320" height="44" />
          {/* La sala encendida, vista desde fuera por el arco. Se mete por debajo de la banda
              del arco: si acabaran en el mismo borde, el suavizado deja ver un hilo de pared */}
          <path class="luz-sala" d="M91 196V84a69 69 0 0 1 138 0v112z" />
          <path class="luz-suelo" d="M96 172h128v24H96z" />
          <ellipse class="luz-brillo" cx="160" cy="112" rx="60" ry="58" />
          <rect class="luz-panel" x="122" y={panel.y} width={panel.ancho} height={panel.alto} rx="3" />
          <rect class="luz-panel" x="166" y={panel.y} width={panel.ancho} height={panel.alto} rx="3" />
          {puntos.map((p) => (
            <circle class="luz-led" cx={p.x} cy={p.y} r="1.9" />
          ))}
          <rect class="luz-taburete" x="140" y="160" width="40" height="7" rx="3" />
          <rect class="luz-taburete" x="145" y="166" width="5" height="10" />
          <rect class="luz-taburete" x="170" y="166" width="5" height="10" />
          {/* El arco de la puerta y la luz roja que sale al suelo de fuera */}
          <path class="e-terracota" d="M86 196V84a74 74 0 0 1 148 0v112h-10V84a64 64 0 0 0-128 0v112z" />
          <path class="luz-salida" d="M96 196h128l50 44H46z" />
          {/* Un olivo junto a la puerta */}
          <path class="e-hoja" d="M262 196c-6-30 0-58 18-74-1 30-6 54-18 74z" />
          <path class="e-hoja-clara" d="M266 196c-12-18-22-26-38-28 8 16 20 24 38 28z" />
        </svg>
      )}
    </div>
  )
}

<style>
  .arco {
    position: relative;
    overflow: hidden;
  }


  .escena {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Comunes */
  .e-sol {
    fill: var(--sol-500);
  }

  .e-halo {
    fill: var(--sol-200);
    opacity: 0.7;
  }

  .e-terracota {
    fill: var(--n700);
  }

  .e-hoja {
    fill: color-mix(in srgb, var(--oliva) 60%, var(--oliva-tinta));
  }

  .e-hoja-clara {
    fill: var(--oliva);
  }

  /* Reformer: la máquina de perfil delante del sol */
  .ref-pared {
    fill: color-mix(in srgb, var(--sol-100) 50%, var(--crema));
  }

  .ref-suelo {
    fill: color-mix(in srgb, var(--sol-300) 30%, var(--tostado));
  }

  .ref-zocalo {
    fill: color-mix(in srgb, var(--sol-300) 45%, var(--tostado));
  }

  .ref-madera {
    fill: color-mix(in srgb, var(--n700) 30%, var(--tostado));
  }

  .ref-madera-osc {
    fill: color-mix(in srgb, var(--n700) 45%, var(--tostado));
  }

  .ref-piel {
    fill: color-mix(in srgb, var(--n700) 85%, var(--tostado));
  }

  .ref-piel-osc {
    fill: color-mix(in srgb, var(--n700) 80%, var(--cacao));
  }

  .ref-metal {
    fill: color-mix(in srgb, var(--cacao) 80%, var(--n700));
  }

  .ref-barra {
    stroke: color-mix(in srgb, var(--cacao) 80%, var(--n700));
    stroke-width: 6;
    stroke-linecap: round;
  }

  .ref-muelles,
  .ref-cuerda {
    fill: none;
    stroke: color-mix(in srgb, var(--cacao) 80%, var(--n700));
    stroke-width: 2;
  }

  .ref-cuerda {
    stroke-width: 1.5;
  }

  .r-polea {
    fill: var(--sol-300);
  }

  /* Sauna: madera y el calor del infrarrojo */
  .sau-tabla-clara {
    fill: color-mix(in srgb, var(--sol-300) 40%, var(--tostado));
  }

  .sau-tabla {
    fill: color-mix(in srgb, var(--sol-300) 55%, var(--tostado));
  }

  .sau-aura {
    fill: var(--sol-300);
    opacity: 0.35;
  }

  .sau-banco {
    fill: color-mix(in srgb, var(--n700) 75%, var(--sol-300));
  }

  .sau-pata {
    fill: color-mix(in srgb, var(--n700) 85%, var(--cacao));
  }

  .sau-suelo {
    fill: color-mix(in srgb, var(--sol-300) 70%, var(--n700));
  }

  .sau-toalla {
    fill: var(--crema);
  }

  .sau-toalla-raya {
    fill: var(--oliva);
  }

  /* Luz roja: la sala encendida al otro lado del arco */
  .luz-sala {
    fill: var(--rojo-700);
  }

  .luz-suelo {
    fill: color-mix(in srgb, var(--rojo-900) 90%, var(--rojo-700));
  }

  .luz-brillo {
    fill: var(--rojo-300);
    opacity: 0.4;
  }

  .luz-panel {
    fill: var(--rojo-500);
  }

  .luz-led {
    fill: var(--rojo-100);
  }

  .luz-taburete {
    fill: var(--cacao);
  }

  .luz-salida {
    fill: var(--rojo-300);
    opacity: 0.45;
  }
</style>
