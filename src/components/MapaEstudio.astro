<style>
  .mapa-osm {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tierra {
    fill: var(--crema);
  }

  .mar {
    fill: var(--n100);
  }

  .plaza {
    fill: var(--n50);
  }

  .verde {
    fill: var(--oliva);
    opacity: 0.38;
  }

  .muelle {
    fill: none;
    stroke: var(--crema);
    stroke-width: 6;
  }

  .menor,
  .calle-borde,
  .media-borde,
  .principal-borde,
  .calle,
  .media,
  .principal {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .menor {
    stroke: var(--n100);
    stroke-width: 1.5;
  }

  .calle-borde {
    stroke: var(--n100);
    stroke-width: 9;
  }

  .calle {
    stroke: #fffaf4;
    stroke-width: 6.5;
  }

  .media-borde {
    stroke: var(--n200);
    stroke-width: 11;
  }

  .media {
    stroke: #fffaf4;
    stroke-width: 8;
  }

  .principal-borde {
    stroke: var(--n300);
    stroke-width: 14;
  }

  .principal {
    stroke: var(--n100);
    stroke-width: 10.5;
  }

  .nombres {
    font: 400 11px var(--font);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--tinta-60);
    paint-order: stroke;
    stroke: var(--crema);
    stroke-width: 4;
    stroke-linejoin: round;
  }

  .punto {
    fill: var(--n500);
    stroke: var(--crema);
    stroke-width: 4;
  }

  .marca path,
  .marca rect {
    fill: var(--tinta);
  }

  .marca text {
    font: 400 14px var(--font);
    letter-spacing: 0.16em;
    fill: var(--crema);
  }
</style>
