---
/*
 * Página de la primera sesión gratis (a ella lleva el botón principal).
 * Es un recorrido por esos 45 minutos, en el orden en que pasan:
 *   1. Arriba, el titular en una línea y la frase de los 45 minutos.
 *   2. Los pasos en fila, cada uno con su píldora (número y minutos) y una flecha al siguiente,
 *      su recorte, su título y su texto. En móvil se deslizan de lado. Acaba en el cierre.
 *   3. Después, y no antes, reservarla: la web de bsport (cuando haya enlace), WhatsApp con
 *      un mensaje ya escrito y la app.
 *   4. Las dudas en una línea.
 */
import { acentuar } from '../lib/acento';
import Base from '../layouts/Base.astro';
import DibujoRazon from './DibujoRazon.astro';
import Icon from './Icon.astro';
import TiendasApp from './TiendasApp.astro';
import Dudas from './secciones/Dudas.astro';
import { getSite, whatsappUrl, type Lang } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { ajustes, home } = await getSite(lang);
const ps = home.primeraSesion!;
const web = ajustes.reservas.primeraSesionUrl;
const wa = whatsappUrl(ajustes.contacto.whatsapp, ps.whatsappMensaje);
const dibujos = ['reformer', 'app', 'entrada', 'ipad'] as const;

// Cada paso con el minuto en que empieza y en el que acaba
const total = ps.incluye.reduce((suma, p) => suma + p.minutos, 0);
const pasos = ps.incluye.map((p, i) => {
  const desde = ps.incluye.slice(0, i).reduce((suma, q) => suma + q.minutos, 0);
  return { ...p, desde, hasta: desde + p.minutos, dibujo: dibujos[i % dibujos.length] };
});
---

<Base lang={lang} titulo={home.botones.principalCorto.abierto} descripcion={ps.texto} pagina="primera-sesion" alternos sinBarraMovil>
  <section class="inicio" aria-labelledby="inicio-titulo">
    <div class="envoltura">
      <h1 id="inicio-titulo" class="t-display inicio__titulo" set:html={acentuar(ps.titulo)} />
      <p class="t-lead inicio__intro">{ps.texto}</p>
    </div>
  </section>

  <section id="incluye" class="camino seccion" aria-labelledby="camino-titulo">
    <div class="envoltura">
      <h2 id="camino-titulo" class="t-h2 camino__titulo" set:html={acentuar(ps.incluyeTitulo)} />

      <ol role="list" class="fila">
        {
          pasos.map((p, i) => (
            <li class="fila__paso" style={`--tramo: var(--tramo-${(i % 4) + 1})`}>
              <div class="fila__marca">
                <span class="fila__num" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="etiqueta fila__min">
                  min {p.desde}–{p.hasta}
                </span>
                <span class="fila__linea" aria-hidden="true" />
              </div>
              <div class="fila__lamina grano">
                <DibujoRazon tipo={p.dibujo} />
              </div>
              <h3 class="fila__titulo">{p.titulo}</h3>
              <p class="fila__texto">{p.texto}</p>
            </li>
          ))
        }
      </ol>

      {
        ps.cierre && (
          <p class="cierre">
            <span class="cierre__sol" aria-hidden="true" />
            <span class="etiqueta">min {total}</span>
            {ps.cierre}
          </p>
        )
      }
    </div>
  </section>

  <section class="reservar" aria-labelledby="reservar-titulo">
    <div class="envoltura">
      <div class="reservar__panel">
        <div class="reservar__texto">
          <h2 id="reservar-titulo" class="t-h2">{ps.reservarTitulo}</h2>
          {ps.reservarTexto && <p class="t-lead reservar__intro">{ps.reservarTexto}</p>}
        </div>
        <div class="reservar__acciones">
          <div class="reservar__botones">
            {
              web && (
                <a class="boton boton-sol" href={web} target="_blank" rel="noopener">
                  {ps.web}
                  <Icon name="flecha" size={20} />
                </a>
              )
            }
            {
              wa && (
                <a class:list={['boton', web ? 'boton--secundario' : 'boton-sol']} href={wa} target="_blank" rel="noopener">
                  <Icon name="whatsapp" size={20} />
                  {ps.whatsapp}
                </a>
              )
            }
          </div>
          {home.porQue && <TiendasApp ajustes={ajustes} textos={home.porQue.app} class="reservar__tiendas" />}
        </div>
      </div>
    </div>
  </section>

  <Dudas home={home} />
</Base>

<style>
  /* ───────── Arriba: el titular en una línea ───────── */
  .inicio {
    padding: var(--pagina-arriba) 0 0;
    background: var(--crema);
  }

  /* Encoge con el ancho hasta caber en una línea (también en francés y alemán, más largos) */
  .inicio__titulo {
    font-size: min(var(--t-display), (100vw - 2 * var(--gutter)) / 13.8);
    white-space: nowrap;
  }

  .inicio__intro {
    max-width: 40ch;
    margin-top: 1rem;
    color: var(--tinta-60);
  }

  /* ───────── Los pasos en fila ───────── */
  /* Los cuatro tramos se calientan como el sol al subir */
  .camino {
    --tramo-1: var(--sol-100);
    --tramo-2: var(--sol-200);
    --tramo-3: var(--sol-300);
    --tramo-4: var(--sol-500);
    --hueco: 1.5rem;
  }

  .camino__titulo {
    margin-bottom: clamp(1.75rem, 1rem + 2vw, 2.5rem);
    text-wrap: balance;
  }

  .fila {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem var(--hueco);
  }

  /* Encima de cada paso, una píldora de su color con el número y los minutos, y una flecha
     hacia el siguiente */
  .fila__marca {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
  }

  .fila__num,
  .fila__min {
    display: grid;
    place-items: center;
    height: 2.25rem;
    background: var(--tramo);
    color: var(--tinta);
  }

  .fila__num {
    padding: 0 0.375rem 0 0.875rem;
    border-radius: var(--r-pill) 0 0 var(--r-pill);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  .fila__min {
    padding: 0 0.875rem 0 0.375rem;
    border-radius: 0 var(--r-pill) var(--r-pill) 0;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .fila__linea {
    position: relative;
    flex: 1;
    height: 2px;
    margin-left: 0.75rem;
    background: var(--linea-fuerte);
  }

  .fila__linea::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-top: 2px solid var(--linea-fuerte);
    border-right: 2px solid var(--linea-fuerte);
    translate: 0 -50%;
    rotate: 45deg;
  }

  /* El último no lleva flecha: después viene el cierre */
  .fila__paso:last-child .fila__linea {
    visibility: hidden;
  }

  .fila__lamina {
    position: relative;
    aspect-ratio: 24 / 14;
    margin-bottom: 0.75rem;
    border-radius: var(--r);
    overflow: hidden;
  }

  .fila__lamina :global(svg) {
    position: absolute;
    inset: 0;
  }

  .fila__titulo {
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-weight: 400;
  }

  .fila__texto {
    margin-top: 0.375rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--tinta-60);
  }

  /* El final del recorrido: un sol lleno y la frase que da paso a reservar */
  .cierre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: clamp(1.75rem, 1rem + 2vw, 2.5rem);
    font-size: 1.125rem;
  }

  .cierre__sol {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--sol-500);
  }

  /* ───────── Reservar, después del recorrido ───────── */
  /* Franja Naranja 100 de borde a borde, como la de la app en la portada */
  .reservar {
    padding-block: var(--seccion);
    background: var(--n100);
  }

  .reservar__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem clamp(2rem, 1rem + 4vw, 5rem);
    align-items: end;
  }

  .reservar__intro {
    max-width: 36ch;
    margin-top: 1rem;
    color: var(--tinta-60);
  }

  .reservar__botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .boton {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 3.5rem;
    padding: 0 1.625rem;
    border-radius: var(--r-pill);
    font-size: 1.0625rem;
    text-decoration: none;
  }

  /* El principal (reservar) es un .boton-sol, con su color y su animación en global.css */
  .boton--secundario {
    background: var(--crema);
    color: var(--tinta);
    box-shadow: inset 0 0 0 1px var(--n200);
    transition:
      background-color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .boton--secundario:hover {
    background: var(--n50);
  }

  .boton:active {
    transform: translateY(1px);
  }

  .reservar :global(.reservar__tiendas) {
    margin-top: 1.25rem;
  }

  /* Tableta: dos pasos por fila; la línea se corta al final de cada fila */
  @media (max-width: 64rem) {
    .fila {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fila__paso:nth-child(2n) .fila__linea {
      visibility: hidden;
    }

    .reservar__panel {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  /* Móvil: los pasos se deslizan de lado en vez de apilarse, y la línea sigue de uno a otro */
  @media (max-width: 36rem) {
    .camino {
      --hueco: 1rem;
    }

    .fila {
      display: flex;
      gap: var(--hueco);
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .fila::-webkit-scrollbar {
      display: none;
    }

    .fila__paso {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }

    .fila__paso:nth-child(2n) .fila__linea {
      visibility: visible;
    }

    .fila__paso:last-child .fila__linea {
      visibility: hidden;
    }

    .boton {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
