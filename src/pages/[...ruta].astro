---
/*
 * Páginas propias en los cuatro idiomas: la primera sesión gratis, los precios,
 * cada espacio (reformer, luz roja, sauna) y las páginas legales. Las direcciones de
 * cada idioma están en src/lib/content.ts → rutas y rutasLegales.
 */
import Base from '../layouts/Base.astro';
import PaginaPrimeraSesion from '../components/PaginaPrimeraSesion.astro';
import Recovery from '../components/secciones/Recovery.astro';
import Clases from '../components/secciones/Clases.astro';
import Precios from '../components/secciones/Precios.astro';
import Explora from '../components/secciones/Explora.astro';
import PaginaLegal from '../components/PaginaLegal.astro';
import { getSite, idiomas, paginas, paginasLegales, rutas, rutasLegales, type Lang, type Pagina, type PaginaLegal as Legal } from '../lib/content';

export function getStaticPaths() {
  const ruta = (lang: Lang, slug: string) => (lang === 'es' ? slug : `${lang}/${slug}`);
  return idiomas.flatMap((lang) => [
    ...paginas.map((pagina) => ({ params: { ruta: ruta(lang, rutas[lang][pagina]) }, props: { lang, pagina } })),
    ...paginasLegales.map((legal) => ({ params: { ruta: ruta(lang, rutasLegales[lang][legal]) }, props: { lang, legal } })),
  ]);
}

type Props = { lang: Lang; pagina: Pagina; legal?: undefined } | { lang: Lang; legal: Legal; pagina?: undefined };
const { lang, pagina, legal } = Astro.props;
const { ajustes, home } = await getSite(lang);
const espacio = pagina === 'reformer' || pagina === 'luz-roja' || pagina === 'sauna' ? pagina : null;
const apartado = espacio ? home.recovery.apartados.find((a) => a.tipo === espacio) : undefined;
---

{
  legal ? (
    <PaginaLegal lang={lang} legal={legal} />
  ) : pagina === 'primera-sesion' ? (
    <PaginaPrimeraSesion lang={lang} />
  ) : pagina === 'precios' ? (
    <Base lang={lang} titulo={home.precios.titulo} descripcion={home.explora?.precios.texto} pagina="precios" alternos>
      <Precios ajustes={ajustes} home={home} pagina />
    </Base>
  ) : (
    <Base lang={lang} titulo={apartado?.titulo} descripcion={apartado?.texto} pagina={pagina} alternos>
      <Recovery home={home} tipos={espacio ? [espacio] : []} pagina />
      {espacio === 'reformer' && <Clases home={home} />}
      <Explora home={home} excluir={pagina} />
    </Base>
  )
}
