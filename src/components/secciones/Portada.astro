---
import { acentuar } from '../../lib/acento';
import CtaButton from '../CtaButton.astro';
import { hayPlazasFundador, plazasFundador, type Ajustes, type Home } from '../../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { ajustes, home } = Astro.props;
const { portada } = home;
// Naranja y cacao llevan el halo de sol; las demás paletas, un fondo liso del color principal
const liso = !['naranja', 'cacao'].includes(ajustes.paleta);
const conFecha = ajustes.estado === 'preapertura' && ajustes.fechaApertura;
const lugar = conFecha
  ? `${ajustes.direccion.ciudad} · ${portada.abrimos} ${ajustes.fechaApertura}`
  : ajustes.direccion.ciudad;

// Antes de abrir, la oferta de fundadores asoma ya en la portada y lleva a su bloque
const f = ajustes.fundadores;
const libres = plazasFundador(ajustes);
const plazas =
  ajustes.estado === 'preapertura' && hayPlazasFundador(ajustes)
    ? libres < f.plazasTotales
      ? `${libres} ${home.precios.fundadores.plazas} ${f.plazasTotales}`
      : home.precios.fundadores.etiqueta
    : '';
---

<section id="portada" class:list={['portada', { 'portada--liso': liso }]} aria-labelledby="portada-titulo">
  <!-- Un sol difuminado a la derecha, sin bordes, sobre el papel crema -->
  {!liso && <div class="portada__halo" aria-hidden="true" />}

  <div class="envoltura portada__texto">
    {conFecha && <p class="portada__fecha">{lugar}</p>}
    <h1 id="portada-titulo" class="portada__titulo" set:html={acentuar(portada.titular)} />
    <div class="portada__acciones">
      <CtaButton ajustes={ajustes} home={home} />
    </div>
    {
      plazas && (
        <a class="portada__plazas" href="#fundadores">
          <span class="portada__plazas-punto" aria-hidden="true" />
          {plazas}
        </a>
      )
    }
  </div>
</section>

<style>
  .portada {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: max(100svh, 44rem);
    max-height: 62rem;
    padding: clamp(7rem, 5rem + 4vw, 8.5rem) 0 var(--seccion);
    background: var(--crema);
  }

  /* El halo de sol */
  .portada__halo {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: -12%;
    width: min(70rem, 110vw);
    aspect-ratio: 1;
    translate: 0 -50%;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      rgb(var(--sol-500-rgb) / 0.45) 0%,
      rgb(var(--sol-300-rgb) / 0.28) 34%,
      rgb(var(--sol-200-rgb) / 0.14) 58%,
      rgb(var(--crema-rgb) / 0) 100%
    );
  }

  /* Paletas alternativas: portada lisa en el color principal. Encima, texto en tinta plena
     (los grises no llegan a contraste); la píldora en crema la pone global.css */
  .portada--liso {
    --texto: var(--tinta-rgb);
    background: var(--n500);
  }

  .portada--liso .portada__titulo {
    color: rgb(var(--texto));
  }

  .portada--liso .portada__fecha,
  .portada--liso .portada__plazas {
    color: rgb(var(--texto) / 0.82);
  }

  .portada--liso .portada__plazas-punto {
    background: var(--crema);
    box-shadow: 0 0 0 4px rgb(var(--crema-rgb) / 0.35);
  }

  .portada__fecha {
    margin-bottom: 1.25rem;
    font-size: 0.9375rem;
    color: var(--tinta-60);
  }

  .portada__titulo {
    max-width: 10ch;
    margin-bottom: 2.25rem;
    font-size: clamp(3rem, 1.4rem + 6vw, 6rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .portada__plazas {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.5rem;
    font-size: var(--t-small);
    color: var(--tinta-60);
    text-decoration: none;
  }

  .portada__plazas:hover {
    color: var(--tinta);
  }

  .portada__plazas-punto {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--r-pill);
    background: var(--n500);
    box-shadow: 0 0 0 4px rgb(var(--n500-rgb) / 0.2);
  }

  /* Móvil: el titular arriba, con el halo asomando por la esquina */
  @media (max-width: 56.25rem) {
    .portada {
      display: block;
      min-height: 0;
      max-height: none;
      padding: 0 0 calc(5.5rem + env(safe-area-inset-bottom));
    }

    .portada {
      padding-top: calc(8rem + var(--aviso-alto));
    }

    .portada__halo {
      top: 22%;
      right: -40%;
    }

    .portada__titulo {
      font-size: clamp(2.75rem, 1.5rem + 7vw, 4rem);
    }

    /* En móvil el botón está en la barra fija inferior */
    .portada__acciones > :global(.cta) {
      display: none;
    }
  }
</style>
