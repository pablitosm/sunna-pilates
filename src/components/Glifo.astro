---
/*
 * Iconos del sistema: formas geométricas de trazo 1,5 px dentro de un círculo
 * (arco, anillo, pantalla, línea, punto, hoja, rectángulo). Estáticos.
 */
interface Props {
  forma: 'arco' | 'anillo' | 'pantalla' | 'linea' | 'punto' | 'hoja' | 'rectangulo';
  tamano?: number;
  class?: string;
}
const { forma, tamano = 56, class: className } = Astro.props;
---

<svg
  class:list={['glifo', className]}
  width={tamano}
  height={tamano}
  viewBox="0 0 56 56"
  fill="none"
  stroke="currentColor"
  stroke-width={1.5 * (56 / tamano)}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <circle class="glifo__trazo" cx="28" cy="28" r="27"></circle>
  {forma === 'anillo' && <circle class="glifo__trazo" cx="28" cy="28" r="11" />}
  {forma === 'arco' && <path class="glifo__trazo" d="M15 36.5V35a13 13 0 0 1 26 0v1.5" />}
  {forma === 'pantalla' && <rect class="glifo__trazo" x="18" y="15" width="20" height="26" rx="4" />}
  {forma === 'linea' && <path class="glifo__trazo" d="M15 28h26" />}
  {forma === 'punto' && <circle class="glifo__punto" cx="28" cy="28" r="9.5" fill="currentColor" stroke="none" />}
  {forma === 'hoja' && <path class="glifo__trazo" d="M15 41V26a11 11 0 0 1 11-11h15v15a11 11 0 0 1-11 11z" />}
  {forma === 'rectangulo' && <rect class="glifo__trazo" x="15" y="22.5" width="26" height="11" rx="2" />}
</svg>

<style>
  .glifo {
    display: block;
    flex: none;
    color: var(--glifo, var(--tinta));
    overflow: visible;
  }

</style>
