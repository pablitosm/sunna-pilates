---
import ContactoDudas from '../ContactoDudas.astro';
import { ctaEsFundador, type Ajustes, type Home } from '../../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
  /** Como página propia: título h1 y más aire arriba. */
  pagina?: boolean;
}
const { ajustes, home, pagina = false } = Astro.props;
const Titulo = pagina ? 'h1' : 'h2';
const { precios } = home;
const euros = (n: number) => new Intl.NumberFormat('es-ES').format(n);
const g = precios.graficos;
const intro = (ctaEsFundador(ajustes) && precios.introFundador) || precios.intro;
---

<section id="precios" class:list={['precios', { 'precios--pagina': pagina }]} aria-labelledby="precios-titulo">
  <div class="envoltura precios__cabeza">
    <div class="cabeza-seccion">
      <div>
        <Titulo id="precios-titulo" class="t-h2 precios__titulo">{precios.titulo}</Titulo>
        {intro && <p class="t-lead precios__intro">{intro}</p>}
      </div>
      {precios.subtitulo && <span class="etiqueta">{precios.subtitulo}</span>}
    </div>
  </div>

  <div class="envoltura precios__tarjetas">
    <ul role="list" class="membresias">
      {
        precios.membresias.map((m) => (
          <li class:list={['membresia', { 'membresia--destacada': m.destacada }]}>
            {m.etiqueta && <span class="membresia__etiqueta">{m.etiqueta}</span>}
            <h3 class="etiqueta membresia__nombre">{m.nombre}</h3>
            <p class="membresia__precio">
              <span class="membresia__cifra">
                {euros(m.precio)} €
              </span>
              <span class="membresia__mes">{home.ui.porMes}</span>
            </p>
            <p class="membresia__sesion">
              <strong>{m.precioSesion}</strong> {precios.porSesion}
            </p>
            <div class="grafico">
              <p class="grafico__sesiones">
                {m.pilates}
                {m.pilatesSemana && <span class="grafico__semana">{m.pilatesSemana}</span>}
              </p>
            </div>

            {g && m.luzRoja !== undefined && m.sauna !== undefined ? (
              <div class="grafico">
                <p class="solo-lectores">{m.recovery}</p>
                <dl class="recovery" aria-hidden="true">
                  {[
                    { nombre: g.luzRoja, n: m.luzRoja },
                    { nombre: g.sauna, n: m.sauna },
                  ].map((r) => (
                    <div class:list={['recovery__fila', { 'recovery__fila--no': r.n === 0 }]}>
                      <dt>{r.nombre}</dt>
                      <dd>{r.n === 0 ? g.noIncluida : r.n < 0 ? g.ilimitado : g.porSemana ? `${r.n} ${g.porSemana}` : r.n}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ) : (
              <p class="grafico__pie">{m.recovery}</p>
            )}

            {m.extra && <p class="membresia__extra">{m.extra}</p>}
          </li>
        ))
      }
    </ul>
    {
      ajustes.reservas.membresiasUrl && (
        <p class="precios__enlace">
          <a class="enlace-flecha" href={ajustes.reservas.membresiasUrl} target="_blank" rel="noopener">
            {home.enlaces.membresias} →
          </a>
        </p>
      )
    }
    {
      precios.contacto && (
        <ContactoDudas ajustes={ajustes} titulo={precios.contacto.titulo} texto={precios.contacto.texto} forma="en-linea" class="precios__contacto" />
      )
    }
  </div>
</section>

<style>
  .precios {
    padding-block: var(--seccion);
  }

  /* Página de precios: más aire arriba (cabecera fija) */
  .precios--pagina {
    display: flex;
    flex-direction: column;
    padding-top: var(--pagina-arriba);
    padding-bottom: 0;
  }

  .precios--pagina .precios__titulo {
    font-size: clamp(2.75rem, 1.8rem + 3.5vw, 4.5rem);
    line-height: 1.02;
  }

  .precios__intro {
    max-width: 64ch;
    text-wrap: balance;
    margin-top: 1.25rem;
    color: var(--tinta-60);
  }

  /* ── Membresías ── */
  .membresias {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .membresia {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    min-height: 22rem;
    padding: 2.125rem 1.875rem;
    border-radius: var(--r-l);
    background: var(--n50);
  }

  .membresia--destacada {
    min-height: 23.75rem;
    box-shadow:
      inset 0 0 0 1.5px var(--n500),
      0 24px 60px rgb(255 130 53 / 0.18);
  }

  .membresia__etiqueta {
    position: absolute;
    left: 1.875rem;
    top: -0.8125rem;
    padding: 0.375rem 0.875rem;
    border-radius: var(--r-pill);
    background: var(--n500);
    color: var(--tinta);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .membresia__nombre {
    margin-bottom: -0.25rem;
  }

  .membresia__precio {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .membresia__cifra {
    font-size: clamp(2.5rem, 1.9rem + 1.8vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .membresia__mes {
    color: var(--tinta-60);
  }

  /* Precio por sesión: dato secundario bajo el precio mensual, visible sin competir con él */
  .membresia__sesion {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    margin-top: -0.375rem;
    font-size: 0.9375rem;
    color: var(--n900);
  }

  .membresia__sesion strong {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--tinta);
  }

  /* Gráficos de cada tarjeta: la semana y el recovery del mes */
  .grafico {
    display: grid;
    gap: 0.625rem;
    padding-top: 1.125rem;
    border-top: 1px solid var(--linea);
  }

  .grafico__titulo {
    font-size: 0.6875rem;
  }

  .grafico__pie {
    font-size: 0.875rem;
    color: var(--tinta-60);
  }

  /* Sesiones de reformer: el dato principal de cada plan */
  .grafico__sesiones {
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .grafico__semana {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    color: var(--tinta-60);
  }

  /* Luz roja y sauna: nombre y cantidad en dos columnas; las cantidades
     arrancan todas en la misma línea vertical */
  .recovery {
    display: grid;
    gap: 0.5rem;
  }

  .recovery__fila {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
    font-size: 0.9375rem;
  }

  .recovery__fila dd {
    color: var(--tinta);
  }

  .recovery__fila--no dt,
  .recovery__fila--no dd {
    color: var(--tinta-60);
  }

  .membresia__extra {
    margin-top: auto;
    padding: 0.625rem 0.875rem;
    border-radius: 12px;
    background: var(--crema);
    font-size: 0.875rem;
    text-align: center;
  }

  /* ¿Dudas con los planes? Bajo las tarjetas */
  .precios__tarjetas :global(.precios__contacto) {
    margin-top: var(--titulo-contenido);
  }

  @media (max-width: 64rem) {
    .membresias {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.75rem;
    }
  }

  @media (max-width: 36rem) {
    .membresias {
      grid-template-columns: 1fr;
    }
    .membresia,
    .membresia--destacada {
      min-height: 0;
    }
  }
</style>
