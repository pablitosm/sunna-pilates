---
import CtaButton from '../CtaButton.astro';
import PhotoSlot from '../PhotoSlot.astro';
import Seguir from '../Seguir.astro';
import { idiomaDe, urlPagina, type Ajustes, type Home } from '../../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { ajustes, home } = Astro.props;
const { portada } = home;
// Secundario: los precios (página propia) si hay texto; si no, cómo funciona
const secundario = home.botones.precios
  ? { texto: home.botones.precios, href: urlPagina(idiomaDe(Astro.currentLocale), 'precios') }
  : { texto: home.botones.secundario, href: '#como-funciona' };
const conFecha = ajustes.estado === 'preapertura' && ajustes.fechaApertura;
const lugar = conFecha
  ? `${ajustes.direccion.ciudad} · ${portada.abrimos} ${ajustes.fechaApertura}`
  : ajustes.direccion.ciudad;

// Antes de abrir, la oferta de fundadores asoma ya en la portada y lleva a su bloque
const f = ajustes.fundadores;
const libres = Math.min(f.plazasLibres, f.plazasTotales);
const plazas =
  ajustes.estado === 'preapertura' && f.mostrar
    ? libres < f.plazasTotales
      ? `${libres} ${home.precios.fundadores.plazas} ${f.plazasTotales}`
      : home.precios.fundadores.etiqueta
    : '';
---

<section id="portada" class:list={['portada', { 'portada--foto': portada.foto }]} aria-labelledby="portada-titulo">
  <!-- La foto del estudio se funde con el papel crema: sin marco ni tarjeta -->
  {
    portada.foto ? (
      <div class="portada__foto">
        <PhotoSlot foto={portada.foto} loading="eager" sizes="(min-width: 56.25rem) 65vw, 100vw" class="portada__imagen" />
      </div>
    ) : (
      <div class="portada__halo" aria-hidden="true" />
    )
  }

  <div class="envoltura portada__texto">
    {conFecha && <p class="portada__fecha">{lugar}</p>}
    <h1 id="portada-titulo" class="portada__titulo">{portada.titular}</h1>
    <p class="portada__subtitulo">{portada.subtitulo}</p>
    <div class="portada__acciones">
      <CtaButton ajustes={ajustes} home={home} />
      <a class="portada__secundario" href={secundario.href}>{secundario.texto}</a>
    </div>
    {
      plazas && (
        <a class="portada__plazas" href="#fundadores">
          <span class="portada__plazas-punto" aria-hidden="true" />
          {plazas}
        </a>
      )
    }
  </div>

  <!-- Invita a bajar hacia «Por qué SUNNA» -->
  {
    home.porQue && (
      <div class="envoltura portada__abajo">
        <Seguir href="#por-que" texto={home.porQue.titulo} />
      </div>
    )
  }
</section>

<style>
  .portada {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: max(100svh, 44rem);
    max-height: 62rem;
    padding: clamp(7rem, 5rem + 4vw, 8.5rem) 0 var(--seccion);
    background: var(--crema);
  }

  /* Escritorio: la foto ocupa la derecha hasta el borde y se desvanece hacia el texto */
  .portada__foto {
    position: absolute;
    z-index: -1;
    inset: 0 0 0 38%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.5) 26%, #000 52%);
    mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.5) 26%, #000 52%);
  }

  .portada__foto :global(.portada__imagen) {
    position: absolute;
    inset: 0;
  }

  /* Un poco de crema abajo para que la sección siguiente no corte en seco */
  .portada--foto::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: auto 0 0;
    height: 18%;
    background: linear-gradient(180deg, rgb(253 246 238 / 0), var(--crema));
    pointer-events: none;
  }

  /* Sin foto: el halo de sol, que respira */
  .portada__halo {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: -12%;
    width: min(70rem, 110vw);
    aspect-ratio: 1;
    translate: 0 -50%;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      rgb(255 130 53 / 0.45) 0%,
      rgb(255 167 107 / 0.28) 34%,
      rgb(255 196 154 / 0.14) 58%,
      rgb(253 246 238 / 0) 100%
    );
    animation: respirar 14s ease-in-out infinite;
  }

  @keyframes respirar {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.92;
    }
    50% {
      transform: scale(1.06);
      opacity: 1;
    }
  }

  .portada__fecha {
    margin-bottom: 1.25rem;
    font-size: 0.9375rem;
    color: var(--tinta-60);
  }

  .portada__titulo {
    max-width: 10ch;
    margin-bottom: 1.5rem;
    font-size: clamp(3rem, 1.4rem + 6vw, 6rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .portada__subtitulo {
    max-width: 36ch;
    margin-bottom: 2.25rem;
    font-size: var(--t-lead);
    line-height: 1.55;
    color: var(--tinta-60);
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .portada__secundario {
    font-size: 1.0625rem;
    color: var(--n900);
    text-underline-offset: 0.25em;
    text-decoration-color: var(--n300);
  }

  .portada__secundario:hover {
    text-decoration-color: var(--n900);
  }

  /* Escritorio: el indicador al pie de la portada, alineado con el texto */
  .portada__abajo {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }

  .portada__plazas {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.5rem;
    font-size: var(--t-small);
    color: var(--tinta-60);
    text-decoration: none;
  }

  .portada__plazas:hover {
    color: var(--tinta);
  }

  .portada__plazas-punto {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--n500);
    box-shadow: 0 0 0 4px rgb(255 130 53 / 0.2);
  }

  /* Móvil: la foto arriba, de borde a borde, fundida en crema por abajo;
     el titular empieza sobre ese degradado */
  @media (max-width: 56.25rem) {
    .portada {
      display: block;
      min-height: 0;
      max-height: none;
      padding: 0 0 calc(5.5rem + env(safe-area-inset-bottom));
    }

    .portada--foto {
      padding-top: min(46svh, 26rem);
    }

    .portada:not(.portada--foto) {
      padding-top: 8rem;
    }

    .portada__foto {
      inset: 0 0 auto;
      height: min(60svh, 34rem);
      -webkit-mask-image: linear-gradient(180deg, #000 45%, rgb(0 0 0 / 0.5) 72%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 45%, rgb(0 0 0 / 0.5) 72%, transparent 100%);
    }

    .portada--foto::after {
      display: none;
    }

    .portada__titulo {
      font-size: clamp(2.75rem, 1.5rem + 7vw, 4rem);
    }

    .portada__subtitulo {
      margin-bottom: 1.5rem;
    }

    .portada__abajo {
      position: static;
      margin-top: 2rem;
    }

    /* En móvil el botón está en la barra fija inferior */
    .portada__acciones > :global(.cta) {
      display: none;
    }
  }
</style>
