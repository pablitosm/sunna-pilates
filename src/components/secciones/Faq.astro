---
import type { Ajustes, Home } from '../../lib/content';

interface Props {
  ajustes: Ajustes;
  home: Home;
}
const { home } = Astro.props;
const { faq } = home;
// Las preguntas sin respuesta (pendientes) no se muestran.
const grupos = faq.grupos
  .map((g) => ({ ...g, preguntas: g.preguntas.filter((p) => p.respuesta.trim()) }))
  .filter((g) => g.preguntas.length);
---

<section id="preguntas" class="faq seccion" aria-labelledby="faq-titulo">
  <div class="faq__halo" aria-hidden="true"></div>
  <div class="envoltura faq__rejilla">
    <h2 id="faq-titulo" class="t-h2 faq__titulo">{faq.titulo}</h2>

    <div class="faq__tarjeta vidrio">
      {
        grupos.map((g, gi) => (
          <div class="grupo">
            <h3 class="etiqueta grupo__titulo">{g.titulo}</h3>
            {g.preguntas.map((p, pi) => (
              <details class="pregunta" name="faq" open={gi === 0 && pi === 0}>
                <summary>
                  <span>{p.pregunta}</span>
                  <span class="pregunta__mas" aria-hidden="true">
                    +
                  </span>
                </summary>
                <p class="pregunta__respuesta">{p.respuesta}</p>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }


  /* El acordeón es vidrio sobre el halo */
  .faq__halo {
    position: absolute;
    z-index: -1;
    right: -10%;
    top: 30%;
    width: min(62rem, 120vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(255 130 53 / 0.4),
      rgb(255 196 154 / 0.2) 55%,
      rgb(253 246 238 / 0)
    );
    pointer-events: none;
  }

  .faq__rejilla {
    display: flex;
    gap: clamp(2rem, 1rem + 5vw, 5rem);
    align-items: flex-start;
  }

  .faq__titulo {
    flex: 0 0 min(26rem, 32%);
    position: sticky;
    top: 7rem;
  }

  .faq__tarjeta {
    flex: 1;
    display: grid;
    gap: 0.5rem;
    padding: 0.875rem;
    border-radius: var(--r-l);
  }

  .grupo__titulo {
    padding: 1.25rem 1.625rem 0.5rem;
  }

  .pregunta {
    border-radius: 16px;
    transition: background-color 0.28s var(--ease);
  }

  .pregunta[open] {
    background: rgb(255 241 230 / 0.5);
  }

  .pregunta summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.5rem 1.625rem;
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.3125rem);
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  .pregunta summary::-webkit-details-marker {
    display: none;
  }

  .pregunta summary:focus-visible {
    border-radius: 16px;
    outline-offset: -3px;
  }

  .pregunta__mas {
    flex: none;
    font-size: 1.375rem;
    line-height: 1;
    color: var(--n900);
    transition: rotate 0.28s var(--ease);
  }

  .pregunta[open] .pregunta__mas {
    rotate: 45deg;
  }

  .pregunta__respuesta {
    max-width: 62ch;
    padding: 0 1.625rem 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  /* La fila abierta empuja a las de abajo, 280 ms */
  .pregunta::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.28s var(--ease),
      content-visibility 0.28s allow-discrete;
  }

  .pregunta[open]::details-content {
    block-size: auto;
  }

  @media (max-width: 56.25rem) {
    .faq__rejilla {
      flex-direction: column;
    }
    .faq__titulo {
      position: static;
    }
    .faq__tarjeta {
      width: 100%;
      padding: 0.5rem;
    }
    .pregunta summary {
      padding: 1.25rem 1.125rem;
    }
    .pregunta__respuesta {
      padding: 0 1.125rem 1.25rem;
    }
    .grupo__titulo {
      padding: 1rem 1.125rem 0.25rem;
    }
  }
</style>
