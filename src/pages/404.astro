---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" indexar={false}>
  <section class="no-encontrada envoltura">
    <h1 class="t-display">Esta página no existe.</h1>
    <p class="t-lead t-secundario">Puede que el enlace haya cambiado.</p>
    <a href="/">Volver al inicio</a>
  </section>
</Base>

<style>
  .no-encontrada {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-block: var(--pagina-arriba) var(--seccion);
  }
</style>
